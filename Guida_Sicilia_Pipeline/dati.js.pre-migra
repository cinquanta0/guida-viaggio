/* Tutti i posti.
   min = minuti reali in auto da Aci Catena (OSRM, percorso stradale).  km = distanza reale.
   b = fascia di distanza.  t = tipo.  g = caratteristiche.  fo = fondo della spiaggia.
   a = indirizzo.  d = descrizione.  img = foto */
module.exports = [
{b:1, n:"A Carretteria", z:"Aci Catena", min:0, t:"pizza", g:"locali", d:"Pizzeria e trattoria, tra le meglio recensite del paese. Poco turistica per definizione: qui turisti non ne passano."},
{b:1, n:"Al Capriccio", z:"Aci Catena", min:0, piedi:"257 m a piedi", t:"pizza street", g:"", d:"Pizzeria, rosticceria e tavola calda, il locale più vicino di tutti. Comodo la sera in cui non avete voglia di guidare."},
{b:1, n:"Al Nuovo Caprice", z:"Aci Catena", min:0, piedi:"370 m a piedi", t:"pizza street", g:"", d:"Pizzeria e rosticceria, pizza a taglio e arancini, a due passi dall'alloggio."},
{b:1, n:"Antico Forno a Legna di Vincenzo Maugeri", z:"Aci Catena", min:0, piedi:"353 m a piedi", t:"pizza", g:"eco", a:"Via Nizzeti 46", d:"Pizza cotta a legna, tradizione artigianale. La pizzeria più vicina a casa in assoluto."},
{b:1, n:"Chiesa dell’Eremo di Sant’Anna", z:"Aci Catena", min:0, t:"vedere", g:"", d:"Chiesa storica del paese, tappa di due minuti se passeggiate in zona."},
{b:1, n:"Crema e Cioccolato Vampolieri", z:"Aci Catena", min:0, t:"dolci", g:"", d:"Gelateria e pasticceria nella frazione di Vampolieri."},
{b:1, n:"Cugini Chiarenza", z:"Aci Catena", min:0, t:"pizza", g:"locali", d:"Pizzeria storica del paese."},
{b:1, n:"Dolce Mousse", z:"Aci Catena", min:0, t:"dolci", g:"", a:"Via Piano Sanfilippo 15", d:"Pasticceria di quartiere."},
{b:1, n:"La Piccantina", z:"Aci Catena", min:0, t:"pizza", g:"locali", a:"Via S.M. del Sangue 61", d:"Altra pizzeria di paese molto ben recensita."},
{b:1, n:"Santa Venera al Pozzo", z:"Aci Catena", min:0, t:"vedere", g:"nascosto", d:"Sito archeologico con resti di terme romane, poco fuori il centro. Quasi nessuno lo conosce."},
{b:1, n:"Supermercato San Francischello", z:"Aci Catena", min:0, piedi:"1,1 km", t:"spesa", g:"eco", d:"Il supermercato più vicino per la spesa di tutti i giorni. Conad a 2 km."},
{b:1, n:"Torre Casalotto", z:"Aci Catena", min:0, t:"vedere", g:"", d:"Torre storica, due minuti di curiosità se passeggiate in paese."},
{b:2, n:"Aquadelferro", z:"Acireale", min:8, km:3.5, t:"pizza pesce", g:"", d:"Tra i più apprezzati della zona, molto forte anche sul pesce oltre che sulla pizza."},
{b:2, n:"Centro storico di Acireale", z:"Acireale", min:8, km:3.5, t:"vedere", g:"", img:"acireale.jpg", d:"Barocco patrimonio UNESCO, la stessa famiglia della Val di Noto. Si gira a piedi in un'oretta."},
{b:2, n:"Cordai Orazio", z:"Acireale", min:8, km:3.5, t:"pizza", g:"", d:"Ottime opzioni vegetariane, molto ben votato."},
{b:2, n:"Frumento", z:"Acireale", min:8, km:3.5, t:"pizza", g:"", d:"Atmosfera romantica, buona per una cena di coppia."},
{b:2, n:"Fuoco Pizza & Burger", z:"Acireale", min:8, km:3.5, t:"pizza", g:"eco", d:"Più informale e conveniente delle altre, anche vegetariano."},
{b:2, n:"Granita nel centro storico", z:"Acireale", min:8, km:3.5, t:"dolci", g:"locali", d:"Acireale è nota proprio per le granite: il centro ha diversi locali dedicati, tra i meglio recensiti della zona. La regola: entra in quello con più gente del posto e meno insegne in inglese."},
{b:2, n:"Il Tocco", z:"Acireale", min:8, km:3.5, t:"pizza", g:"top", d:"Il nome che spicca su tutte le classifiche locali: partner di Molino Quaglia e Farina Petra, impasto d'autore. Prova la Top Sicily (stracciatella, pesto di pistacchio, sale di Trapani) o la fuori menu Speck+Cheddar."},
{b:2, n:"La Vela", z:"Acireale", min:8, km:3.5, t:"pesce", g:"", d:"Cucina di pesce elegante, per una cena curata."},
{b:2, n:"Opera dei Pupi &mdash; Teatro Turi Grasso", z:"Acireale", min:8, km:3.5, t:"vedere", g:"nascosto", img:"pupi.jpg", d:"I pupi siciliani sono patrimonio UNESCO e Acireale è una delle poche città dove si fanno ancora spettacoli veri, non per turisti. Il teatro della famiglia Grasso lavora dagli anni Venti. Controllate il calendario: non recitano tutte le sere."},
{b:2, n:"Le Chiazzette e la Scala d’Aci", z:"Acireale", min:10, km:5, t:"vedere", g:"nascosto", img:"chiazzette.jpg", d:"Mulattiera del Seicento che scende dal centro di Acireale fino a Santa Maria La Scala, dentro la Riserva della Timpa, con torri di guardia lungo il percorso. Mezz'ora in discesa, di piu' a risalire: fatela la mattina presto."},
{b:2, n:"Spiaggia del Mulino", z:"Riserva della Timpa", min:10, km:5, t:"mare", g:"nascosto", fo:"ciottoli", img:"timpa.jpg", piu:["timpa-2.jpg"], a:"A piedi dal sentiero della Scala d'Aci", d:"Per molti la più bella della zona, e resta tranquilla proprio perché in auto non ci arrivi: serve una camminata. Acqua cristallina, macchia mediterranea, quasi nessuno."},
{b:2, n:"Aci Trezza — Faraglioni dei Ciclopi", z:"Aci Trezza", min:11, km:6.4, t:"mare", g:"top", fo:"scogli", img:"acitrezza.jpg", piu:["acitrezza-2.jpg","acitrezza-3.jpg"], d:"Otto faraglioni vulcanici in riserva marina. La cartolina della costa. Si può fare un giro in barca. Ad agosto arrivate presto: dopo le 10 si riempie."},
{b:2, n:"Capo Mulini e Stazzo", z:"Frazioni di Acireale", min:11, km:5.4, t:"mare", g:"", fo:"scogli", img:"capomulini.jpg", piu:["capomulini-2.jpg"], d:"Calette meno affollate del centro. A Stazzo e Pozzillo ci sono lidi con rosticceria siciliana sul posto: pranzo risolto senza muovere l'auto."},
{b:2, n:"Faraglioni Restaurant", z:"Costa acese", min:11, km:5.4, t:"pesce", g:"vista", d:"Tra i romantici più frequentati, con vista sui faraglioni."},
{b:2, n:"Santa Maria La Scala", z:"Sotto Acireale", min:13, km:6.4, t:"mare", g:"", fo:"scogli", img:"santamarialascala.jpg", piu:["santamarialascala-2.jpg","santamarialascala-3.jpg"], d:"Borgo di pescatori con le barche in secca. Scogliere laviche, acqua limpida, atmosfera vera."},
{b:2, n:"Isola Lachea e giro in barca", z:"Aci Trezza", min:14, km:7.3, t:"mare vedere", g:"", fo:"scogli", img:"lachea.jpg", piu:["lachea-2.jpg"], d:"Il più grande dei faraglioni è un'isola vera, con un piccolo museo e una casa del custode. I pescatori del porticciolo fanno il giro dei faraglioni in barca: mezz'ora, si contratta sul posto."},
{b:2, n:"Trecastagni", z:"Trecastagni", min:14, km:8.3, t:"vedere carne", g:"locali", img:"trecastagni.jpg", d:"Paese etneo a un quarto d'ora da casa, noto per le salsicce e le carni alla brace nei ristoranti di paese. Vista sul golfo di Catania dal sagrato della Basilica."},
{b:2, n:"Castello Normanno di Aci Castello", z:"Aci Castello", min:15, km:8.2, t:"vedere", g:"top", img:"acicastello.jpg", d:"Castello del 1076 costruito su uno sperone di lava nera a picco sul mare, con il museo dentro e la vista sui faraglioni dall'alto. È la cosa più bella a un quarto d'ora da casa, e nel documento di partenza non c'era."},
{b:2, n:"Santa Tecla", z:"Acireale nord", min:15, km:7.4, t:"mare", g:"nascosto", fo:"scogli", img:"santatecla.jpg", piu:["santatecla-2.jpg","santatecla-3.jpg"], d:"Scogliere laviche e calette da cui tuffarsi. Molto più raccolta di Aci Trezza e poco nota ai turisti di passaggio."},
{b:2, n:"Scogli di Ognina", z:"Catania", min:15, km:8.2, t:"mare", g:"nascosto", fo:"scogli", img:"ognina.jpg", d:"Piccolo porto naturale scavato nella lava tra Catania e Aci Castello, con le barche ormeggiate sotto la chiesa. Ci si tuffa dagli scogli piatti, e ci vanno quasi solo catanesi."},
{b:2, n:"Scogliera di Aci Castello", z:"Aci Castello", min:15, km:8.2, t:"mare", g:"", fo:"scogli", img:"scoglieraacicastello.jpg", piu:["scoglieraacicastello-2.jpg","scoglieraacicastello-3.jpg"], d:"Piattaforme di lava sotto il castello con scalette per entrare in acqua. Niente sabbia, ma il fondale è pulito e a due passi c'è tutto."},
{b:2, n:"Macchia di Giarre", z:"Giarre", min:18, km:15.7, t:"vedere", g:"nascosto", img:"macchiagiarre.jpg", d:"Borgo agricolo sulle pendici dell'Etna sopra Giarre, con le case in pietra lavica e la vista che scende fino al mare. Cinque minuti di deviazione salendo."},
{b:2, n:"Giarre e il Duomo di Sant’Isidoro", z:"Giarre", min:19, km:16.8, t:"vedere", g:"nascosto", img:"duomogiarre.jpg", d:"Il duomo neoclassico con i due campanili gemelli è una delle chiese più grandi della Sicilia e si vede da tutta la piana. Il centro è vivo la sera e non ci passa un turista."},
{b:2, n:"Gli Incompiuti di Giarre", z:"Giarre", min:19, km:16.8, t:"vedere", g:"nascosto", img:"incompiuti.jpg", d:"Giarre è la capitale mondiale delle opere pubbliche mai finite: uno stadio da polo, un teatro, una piscina, un palazzetto, tutti costruiti a metà e mai aperti. Un collettivo di artisti li ha catalogati come <b>Incompiuto Siciliano</b> e oggi sono considerati un movimento architettonico. Roba che non trovate in nessuna guida."},
{b:2, n:"La Praiola", z:"Giarre", min:19, km:16.8, t:"mare", g:"nascosto", fo:"ciottoli", d:"Spiaggia di ciottoli neri sotto una scogliera, si scende da una stradina. Poco attrezzata e per questo poco affollata: ci vanno soprattutto i giarresi."},
{b:2, n:"Macelleria Longo", z:"Gravina di Catania", min:19, km:12.4, t:"carne", g:"top", a:"Via Antonio Gramsci 103A", d:"4,8 stelle con oltre mille recensioni, fuori dal centro e per questo piena di gente del posto. Macelleria e ristorante insieme. Fila nei weekend."},
{b:2, n:"Nicolosi e i Monti Rossi", z:"Nicolosi", min:20, km:13.8, t:"vedere", g:"gratis", img:"montirossi.jpg", d:"La porta dell'Etna: si attraversa salendo al Rifugio Sapienza. I Monti Rossi sono due crateri spenti con una pineta, comodi per una passeggiata breve senza salire in quota."},
{b:2, n:"Zafferana Etnea", z:"Zafferana Etnea", min:20, km:13.5, t:"vedere dolci", g:"nascosto", img:"zafferana.jpg", d:"Capitale del miele siciliano e balcone sull'Etna. Pasticcerie ovunque, e le zeppole sono la specialità. Sosta naturale scendendo dal Rifugio Sapienza."},
{b:3, n:"Pozzillo", z:"Acireale nord", min:21, km:11.9, t:"mare", g:"nascosto", fo:"scogli", img:"pozzillo.jpg", d:"Borgo marinaro con scogliera lavica e qualche lido attrezzato con rosticceria sul posto. Il più vicino dei paesi di mare a nord, e quasi solo gente del posto."},
{b:3, n:"San Giovanni Li Cuti", z:"Catania", min:21, km:13.4, t:"mare", g:"", fo:"scogli", img:"licuti.jpg", piu:["licuti-2.jpg"], d:"Spiaggia urbana rocciosa incastrata tra le case: piccola, ma ci si tuffa in città."},
{b:3, n:"Villa Bellini", z:"Catania", min:21, km:14.1, t:"vedere", g:"eco gratis", img:"bellini.jpg", d:"Il giardino storico della città, con il grande orologio floreale e l'ombra dei ficus. Gratis, e utile per far passare le ore peggiori del caldo. All'ingresso c'è la rosticceria Quaranta."},
{b:3, n:"Achille", z:"Catania — Via Plebiscito", min:22, km:15, t:"carne", g:"", a:"Via Plebiscito 734", d:"Polpette di cavallo e salsiccia col pistacchio, street cooking vero."},
{b:3, n:"Carne Doc da Nuccio", z:"Catania — Via Plebiscito", min:22, km:15, t:"carne", g:"eco", a:"Via Plebiscito 343", d:"Panino con carne di cavallo a 5€. Vi fanno accomodare anche se sembra solo asporto."},
{b:3, n:"Dal Tenerissimo", z:"Catania — Via Plebiscito", min:22, km:15, t:"carne", g:"eco", a:"Via Plebiscito 746/750", d:"Filetto e misto di cavallo alla griglia, porzioni abbondanti, prezzi onesti."},
{b:3, n:"Ferrovia Circumetnea", z:"Riposto", min:22, km:18.9, t:"vedere", g:"nascosto", img:"circumetnea.jpg", d:"Trenino a scartamento ridotto che gira tutto intorno all'Etna, 110 km da Riposto a Catania passando per Randazzo e Bronte. Il capolinea è qui accanto. È lento e vecchio, ed è esattamente per questo che vale: si attraversano le colate laviche e i pistacchieti dal finestrino."},
{b:3, n:"Macelleria Equina D'Antone — U Scucciatu", z:"Catania — Via Plebiscito", min:22, km:15, t:"carne", g:"top locali", a:"Via Plebiscito 839", d:"Il proprietario griglia fuori e porta la carne calda al tavolo. Polpette di cavallo e involtini tra i più lodati di tutta Via Plebiscito."},
{b:3, n:"Macelleria Leone Antonino", z:"Catania — Via Plebiscito", min:22, km:15, t:"carne", g:"eco", a:"Via Plebiscito 365", d:"Pollo alla griglia molto apprezzato, prezzi bassi."},
{b:3, n:"Riposto e il porto dell'Etna", z:"Riposto", min:22, km:18.9, t:"vedere mare", g:"nascosto", img:"riposto.jpg", piu:["riposto-2.jpg","riposto-3.jpg"], d:"Marina grande, lungomare per la passeggiata serale e gelaterie. Poco turistico: qui ci vanno soprattutto i catanesi."},
{b:3, n:"Al Vicolo Pizza & Vino", z:"Catania", min:23, km:15, t:"pizza", g:"", a:"Via del Colosseo 5/7", d:"Pizze da 50 cm e antipasti da condividere: fatta apposta per un gruppo."},
{b:3, n:"Anfiteatro Romano", z:"Catania", min:23, km:15, t:"vedere", g:"gratis nascosto", img:"anfiteatro.jpg", a:"Piazza Stesicoro", d:"Se ne vede solo un pezzo, affiorante in mezzo alla piazza sotto il livello della strada, ma era il secondo piu' grande della Sicilia dopo Siracusa. Si guarda dall'alto gratis passando per Via Etnea."},
{b:3, n:"Antica Rosticceria since 1890", z:"Catania", min:23, km:15, t:"street", g:"eco", a:"Via Pardo 5", d:"Arancini, caponata, calamari ripieni. Più di un secolo di attività."},
{b:3, n:"Arancini Espressi Serafino", z:"Catania", min:23, km:15, t:"street", g:"eco", a:"Via Musumeci 90", d:"Arancini fatti al momento, tante varianti, circa 2,50€ l'uno."},
{b:3, n:"Caffè Europa", z:"Catania", min:23, km:15, t:"street dolci", g:"locali", a:"Corso Italia 302", d:"La cipollina qui è considerata tra le migliori, con vista sull'acqua. Ottime anche cartocciate e siciliana fritta."},
{b:3, n:"Carne di Cavallo Dusmet da Riccardo", z:"Catania", min:23, km:15, t:"carne", g:"creator", a:"Via Cardinale Dusmet 119", d:"Macelleria con zona ristoro informale. Fettine sottili nel panino rustico e polpette, carne tenera e leggermente più dolce del manzo."},
{b:3, n:"Casa delle Crispelle", z:"Catania", min:23, km:15, t:"street dolci", g:"nascosto eco", d:"Crispelle salate (acciuga o ricotta) e dolci (miele o Nutella). Frittura leggera. Una chicca che i giri turistici saltano."},
{b:3, n:"Catania Social Club", z:"Catania", min:23, km:15, t:"pizza pasta", g:"", a:"Piazza Scammacca 5", d:"Pizza e pasta alla Norma, bella atmosfera."},
{b:3, n:"Chocofusion", z:"Catania", min:23, km:15, t:"dolci", g:"creator", a:"Viale Vittorio Veneto 52/D", d:"Cannolo farcito solo al momento dell'ordine, torta al pistacchio molto lodata."},
{b:3, n:"Cutilisci", z:"Catania", min:23, km:15, t:"pizza pesce", g:"vista", a:"Via S. Giovanni Li Cuti 69", d:"Sul mare in una piccola darsena, terrazza illuminata, pesce fresco. Rilassato e lontano dal caos del centro."},
{b:3, n:"Gelateria Bar Ernesto", z:"Catania", min:23, km:15, t:"dolci", g:"creator vista", a:"Viale Ruggero di Lauria 91/93", d:"Quasi 8.000 recensioni. Arancini croccanti e granita tra le migliori, terrazza con vista mare."},
{b:3, n:"Happy Sicily", z:"Catania", min:23, km:15, t:"spesa", g:"eco", a:"Via Vittorio Emanuele II 274", d:"Souvenir e prodotti tipici a prezzi più abbordabili."},
{b:3, n:"Ikebana", z:"Catania", min:23, km:15, t:"pizza", g:"creator", a:"Via Pietra dell'Ova 209", d:"4,8 stelle. Napoletana con impasto leggerissimo a lunga lievitazione, cornicione alto. Location curata."},
{b:3, n:"L'Antica Pizzeria da Michele", z:"Catania", min:23, km:15, t:"pizza", g:"eco", a:"Via A. Manzoni 80", d:"Napoletana autentica, ottimo rapporto qualità-prezzo."},
{b:3, n:"La Pentolaccia", z:"Catania", min:23, km:15, t:"pasta", g:"top prenotare", a:"Via Coppola 30", d:"Norma come deve essere e pasta al pistacchio ottima: molti la considerano la migliore di Catania. Prenotare."},
{b:3, n:"La Pescheria — 'A Piscaria", z:"Catania", min:23, km:15, t:"vedere street", g:"top locali", img:"catania_pescheria.jpg", a:"Dietro Piazza Duomo", d:"Mercato del pesce dal Cinquecento, e non è una messinscena per turisti. Lunedì-sabato 7:00-14:00, chiuso domenica. Presto per il pescato appena arrivato, metà mattina per il caos. Pavimento bagnato: scarpe adatte."},
{b:3, n:"Locanda Cerami", z:"Catania", min:23, km:15, t:"pizza pasta", g:"", a:"Via Crociferi 69", d:"Pizza top e tagliatelle al tartufo, nella via barocca più bella della città."},
{b:3, n:"Mad in Italy", z:"Catania", min:23, km:15, t:"pizza", g:"", a:"Via A. di Sangiuliano 234", d:"Pizza gourmet e cocktail creativi."},
{b:3, n:"Maravigghia Gelateria", z:"Catania", min:23, km:15, t:"dolci", g:"", a:"Via Giuseppe Garibaldi 64", d:"Cannolo ricotta e pistacchio, gelato eccellente."},
{b:3, n:"Mizzica", z:"Catania", min:23, km:15, t:"spesa", g:"", a:"Via Giuseppe Garibaldi 13", d:"Prodotti tipici siciliani di qualità. Prezzi un po' alti."},
{b:3, n:"mm street food", z:"Catania — Pescheria", min:23, km:15, t:"street pesce", g:"locali eco", a:"Via Pardo 26", d:"Dentro il mercato del pesce: freschissimo e senza fronzoli."},
{b:3, n:"Monastero dei Benedettini", z:"Catania", min:23, km:15.3, t:"vedere", g:"nascosto prenotare", img:"catania_benedettini.jpg", d:"Uno dei complessi monastici più grandi d'Europa, costruito sopra la colata lavica e oggi sede dell'università. Si visita con guida e quasi nessun turista lo mette in programma."},
{b:3, n:"Negozi di informatica", z:"Catania", min:23, km:15, t:"spesa", g:"", d:"PC Castle (P.za Federico di Svevia 68), Easy Work Computer (Via M.R. Imbriani 245), World Center PC (Via Ferrante Aporti 6), Euronics Bruno (Via Luigi Rizzo 32). Assistenza e vendita: niente merchandising dev o gaming dedicato, per quello meglio online."},
{b:3, n:"Panetteria Pacini", z:"Catania", min:23, km:15, t:"street", g:"eco locali", a:"Via Pacini 45", d:"Un'istituzione per la cipollina, il rustico che a Catania regna sovrano: sfoglia, cipolla stufata, prosciutto, pomodoro."},
{b:3, n:"Pasta Bistrot", z:"Catania", min:23, km:15, t:"pasta carne", g:"", a:"Via Umberto I 20", d:"Norma consigliata, e polpette di cavallo se volete unire pasta e carne."},
{b:3, n:"Pasta Up", z:"Catania", min:23, km:15, t:"pasta", g:"eco", a:"Piazza Giuseppe Mazzini 19", d:"Pasta fresca fatta in casa, ambiente vivace, a due passi dal Duomo."},
{b:3, n:"Pasticceria Luigi Ficarra", z:"Catania", min:23, km:15, t:"dolci", g:"", a:"Via Umberto I 69/71", d:"Cannolo fresco, granita alla mandorla ottima."},
{b:3, n:"Pasticceria Prestipino", z:"Catania", min:23, km:15, t:"dolci", g:"creator", a:"Piazza del Duomo 1", d:"Granita al caffè con panna e brioche molto lodate, con vista sull'elefante. C'è chi la preferisce al Bam Bar di Taormina."},
{b:3, n:"Pasticceria Savia", z:"Catania", min:23, km:15, t:"dolci street", g:"locali", a:"Via Etnea 300/302/304", d:"Istituzione storica: arancini e cannoli entrambi top, sempre affollata di catanesi. Famosa anche per il ricco banco di mini rustici già dal mattino."},
{b:3, n:"Pasticceria Sottile", z:"Catania", min:23, km:15, t:"dolci", g:"locali", a:"Via Lago di Nicito 15/17", d:"Tra i migliori cannoli di tutta la Sicilia secondo moltissime recensioni. Fuori dai circuiti del centro."},
{b:3, n:"Pasticceria Verona & Bonvegna", z:"Catania", min:23, km:15, t:"dolci", g:"eco locali", a:"Via Asiago 60", d:"Solo asporto, molto di quartiere, prezzi onesti. Zero turisti."},
{b:3, n:"Piazza Duomo e Via Etnea", z:"Catania", min:23, km:15, t:"vedere", g:"", img:"catania_duomo.jpg", d:"L'elefante di pietra lavica, il barocco nero e la via dello shopping che punta dritta all'Etna."},
{b:3, n:"Quaranta", z:"Catania", min:23, km:15, t:"street", g:"top eco", a:"Piazza Mancini Battaglia 17/20, ingresso Villa Bellini", d:"Rosticceria da forno iconica: bolognesi e pizzette ben lievitate, calzoni al sesamo. Offerta catanesissima che non sbaglia un colpo."},
{b:3, n:"Sazi e Sani", z:"Catania", min:23, km:15, t:"pizza", g:"eco", a:"Via Sant'Euplio 122", d:"Pizze enormi, farina propria. Molti ci tornano due volte in tre giorni."},
{b:3, n:"Scirocco Sicilian Fish Lab", z:"Catania — Pescheria", min:23, km:15, t:"street pesce", a:"Piazza Alonzo di Benedetto 7", g:"locali", d:"Cono di fritto misto, polpette e arancini di pesce, sarde a beccafico. Amato dai catanesi tanto quanto dai turisti: ha vinto una puntata di Food Advisor."},
{b:3, n:"Teatro Romano e Odeon", z:"Catania", min:23, km:15.6, t:"vedere", g:"nascosto", img:"teatroromano.jpg", d:"Un teatro romano incastrato tra i palazzi del centro, con le case costruite sopra le gradinate. Si entra da Via Vittorio Emanuele e quasi nessuno lo mette in programma: costa poco ed è a due passi dal Duomo."},
{b:3, n:"Trattoria da Nino", z:"Catania", min:23, km:15, t:"pasta carne", g:"locali", d:"Citata da uno chef catanese come il posto per i sapori autentici della cucina catanese: quello che consiglia a chi vuole la vera Catania."},
{b:3, n:"Trattoria U Fucularu", z:"Catania", min:23, km:15, t:"pasta", g:"locali", a:"Via Euplio Reina 20", d:"Norma consigliata da tutti, ravioli tra i migliori. Musica dal vivo la sera."},
{b:3, n:"Via Etnea", z:"Catania", min:23, km:15, t:"spesa", g:"", img:"viaetnea.jpg", d:"La via dello shopping catanese, attraversa tutto il centro con l’Etna in fondo alla prospettiva. Via Umberto I per le boutique più eleganti, zona Duomo per il mix di negozi e street style."},
{b:3, n:"Castello Ursino", z:"Catania", min:24, km:16.2, t:"vedere", g:"", img:"catania_ursino.jpg", d:"Fortezza di Federico II del Duecento, oggi museo civico. Una curiosità: era sul mare, poi la colata del 1669 lo circondò e ora è nell'entroterra."},
{b:3, n:"Torre Archirafi", z:"Riposto", min:24, km:20, t:"mare", g:"nascosto", fo:"scogli", img:"torrearchirafi.jpg", piu:["torrearchirafi-2.jpg","torrearchirafi-3.jpg"], d:"Borgo sulla scogliera con piscine naturali tra la lava e la celebre acqua sorgiva che sgorga dalla roccia, imbottigliata da sempre. Uno dei posti meno battuti della zona."},
{b:3, n:"Fondachello", z:"Mascali", min:25, km:21.7, t:"mare", g:"eco", fo:"sabbia", img:"fondachello.jpg", d:"Chilometri di spiaggia di sabbia e ghiaia scura, lidi e tratti liberi, con l'Etna alle spalle. È la sabbia vera più vicina a casa vostra: venticinque minuti, contro i trentaquattro della Plaia di Catania."},
{b:3, n:"Milo", z:"Milo", min:25, km:17.9, t:"vedere spesa", g:"nascosto", img:"milo.jpg", d:"Borgo minuscolo sul versante est. È l'unico posto dove si produce l'Etna Bianco Superiore DOC: se volete portare a casa una bottiglia dell'Etna, si compra qui."},
{b:3, n:"Marina di Cottone e riserva del Fiumefreddo", z:"Fiumefreddo di Sicilia", min:28, km:29.3, t:"mare", g:"nascosto", fo:"ciottoli", img:"fiumefreddo.jpg", piu:["fiumefreddo-2.jpg","fiumefreddo-3.jpg"], d:"Spiaggia lunga di ciottoli e sabbia scura, molto meno affollata di quelle a sud. Accanto la riserva del fiume Fiumefreddo, con acque sorgive gelide e papiri spontanei."},
{b:3, n:"Giardini Naxos", z:"Giardini Naxos", min:31, km:35.1, t:"mare", g:"eco", fo:"sabbia", img:"giardininaxos.jpg", piu:["giardininaxos-2.jpg","giardininaxos-3.jpg"], d:"Spiaggia lunga e sabbiosa, molto meno turistica di Taormina. Anche per mangiare qui si spende parecchio meno."},
{b:3, n:"Mazzarò", z:"Taormina", min:31, km:38.4, t:"mare", g:"", fo:"ciottoli", img:"mazzaro.jpg", piu:["mazzaro-2.jpg"], d:"La baia accanto a Isola Bella: più ampia, con stabilimenti, e generalmente meno affollata."},
{b:3, n:"Isola Bella", z:"Taormina", min:32, km:38.9, t:"mare", g:"top", fo:"ciottoli", img:"isolabella.jpg", piu:["isolabella-2.jpg"], a:"Funivia o scalinata dal centro", d:"La spiaggia più iconica della Sicilia, acqua cristallina sotto scogliere spettacolari. Ad agosto: presto la mattina o tardo pomeriggio, in mezzo è invivibile."},
{b:3, n:"Bam Bar", z:"Taormina", min:33, km:40.3, t:"dolci", g:"top", a:"Via di Giovanni 45", d:"Il numero uno per la granita secondo moltissimi. Brioche calda, granita mai troppo dolce: abbinate mandorla con un frutto. C'è fila, ma scorre veloce."},
{b:3, n:"Boutique Di Donato / La Maglietta", z:"Taormina", min:33, km:40.3, t:"spesa", g:"", a:"Corso Umberto 48", d:"T-shirt a tema Sicilia (linea Le Siciliane), felpe e souvenir tessili."},
{b:3, n:"Briguglio’s Ricami e Souvenir", z:"Taormina", min:33, km:40.3, t:"spesa", g:"", d:"Ricamo siciliano tradizionale: tovaglie e tessuti lavorati a mano."},
{b:3, n:"Corso Umberto I", z:"Taormina", min:33, km:40.3, t:"spesa", g:"", img:"corsoumberto.jpg", d:"Da Porta Messina a Porta Catania: boutique di moda, botteghe artigiane, ceramica e souvenir. La via più griffata dell’isola, con i prezzi che ne conseguono."},
{b:3, n:"Da Totò", z:"Taormina", min:33, km:40.3, t:"pasta", g:"", a:"Viale Apollo Arcageta 13", d:"Arancino con ragù e formaggio filante, cucina siciliana autentica."},
{b:3, n:"Kuttigghiu", z:"Taormina", min:33, km:40.3, t:"pasta pesce", g:"nascosto", a:"Vico C di Via di Giovanni 5", d:"Colorato ed eccentrico, fuori dal Corso principale e quindi fuori dai prezzi del Corso. Insalata di mare e carbonara lodate. Coperto 3€ dichiarato in menu."},
{b:3, n:"La Napoletana", z:"Taormina", min:33, km:40.3, t:"pizza", g:"top", a:"Piazza Varò", d:"Considerata da molti la migliore napoletana di tutta la Sicilia, e con prezzi onesti (12-16€) in una città dove niente lo è."},
{b:3, n:"La Romana", z:"Taormina", min:33, km:40.3, t:"pizza", g:"", a:"Via Cappuccini 1", d:"Crosta sottilissima e croccante, tra le più lodate in assoluto."},
{b:3, n:"Pizza Al Taglio Arancini", z:"Taormina", min:33, km:40.3, t:"street pizza", g:"eco", a:"Vico B S. Pancrazio 46", d:"Arancini tra i migliori della città a 2,50€. Il modo per mangiare a Taormina senza svenarsi."},
{b:3, n:"Restaurant @ Villa Carlotta", z:"Taormina", min:33, km:40.3, t:"pesce", g:"vista", a:"Via Luigi Pirandello 81", d:"Vista su mare ed Etna, agnello ottimo. Fuori dal centro affollato, per una sera speciale."},
{b:3, n:"RG Souvenirs", z:"Taormina", min:33, km:40.3, t:"spesa", g:"", d:"Souvenir, ceramica con decalcomania e articoli in terracotta di ogni tipo."},
{b:3, n:"Rosticceria Da Cristina", z:"Taormina", min:33, km:40.3, t:"street", g:"eco locali", a:"Via Strabone 2 e Via G. di Giovanni 28", d:"Dal 1980. Arancini fatti al momento, melanzane e pistacchio tra i più lodati. Prezzi onesti e sempre pieno di gente del posto: a Taormina è una rarità."},
{b:3, n:"stritFUD", z:"Taormina", min:33, km:40.3, t:"street", g:"eco", a:"Via G. di Giovanni 23", d:"Sfincione, scacciata, panelle, tutto fatto in casa, gestione familiare."},
{b:3, n:"Teatro Antico di Taormina", z:"Taormina", min:33, km:40.3, t:"vedere", g:"top", img:"taormina_teatro.jpg", d:"Il teatro greco affacciato sul mare con l'Etna sullo sfondo. Caro e affollato, ma la vista è quella che è."},
{b:3, n:"Villa Comunale", z:"Taormina", min:33, km:40.3, t:"vedere", g:"gratis nascosto", img:"villacomunale.jpg", d:"Giardino pubblico a terrazze con le 'victorian follies' in mattoni volute da Lady Florence Trevelyan, e la vista sulla baia. Gratis, ombreggiato, e vuoto mentre il Corso e' pieno."},
{b:3, n:"Villa Zuccaro", z:"Taormina", min:33, km:40.3, t:"pizza", g:"", a:"Piazza Carmine 5", d:"Giardino con ulivo, atmosfera romantica, tiramisù da non perdere."},
{b:3, n:"La Plaia", z:"Catania", min:34, km:31.3, t:"mare", g:"", fo:"sabbia", img:"laplaia.jpg", d:"La lunga spiaggia sabbiosa di Catania: stabilimenti e ampie zone libere. La risposta facile quando volete sabbia e non scogli."},
{b:3, n:"Letojanni", z:"Letojanni", min:35, km:41, t:"mare", g:"eco", fo:"ciottoli", img:"letojanni.jpg", piu:["letojanni-2.jpg"], d:"Spiaggia lunga di ciottoli con lidi e lungomare, cinque minuti oltre Taormina. Si mangia e si parcheggia a metà di quello che costa là sopra. A fine agosto c’è anche la Sagra del Pesce."},
{b:4, n:"Castello Normanno di Paternò", z:"Paternò", min:38, km:33.4, t:"vedere", g:"nascosto", img:"paterno.jpg", d:"Torrione normanno del 1072 in pietra lavica, piantato su una rupe con vista sulla piana di Catania e sull'Etna. Fuori da ogni circuito: ci si ferma quando si torna dall'Etna."},
{b:4, n:"Oasi del Simeto", z:"Catania sud", min:39, km:35.2, t:"mare vedere", g:"nascosto gratis", fo:"sabbia", img:"simeto.jpg", piu:["simeto-2.jpg","simeto-3.jpg"], d:"Riserva alla foce del Simeto, subito dopo la Plaia: dune, pantani e uccelli migratori, con chilometri di sabbia quasi deserta. È la spiaggia libera più vicina a Catania dove non trovate nessuno."},
{b:4, n:"Gole dell'Alcantara", z:"Motta Camastra", min:40, km:44.4, t:"vedere mare", g:"", fo:"ciottoli", img:"alcantara.jpg", piu:["alcantara-2.jpg","alcantara-3.jpg"], d:"Canyon di basalto nero alto venti metri con acqua gelida in cui si cammina. Una delle poche cose davvero fresche di agosto, a 20 minuti da Taormina."},
{b:4, n:"Castelmola", z:"Sopra Taormina", min:42, km:45.4, t:"vedere", g:"nascosto", img:"castelmola.jpg", d:"Borgo minuscolo dieci minuti di tornanti sopra Taormina: vista su tutta la baia e il celebre vino alla mandorla del Bar Turrisi. Ci si sale quando Taormina è troppo piena."},
{b:4, n:"Santa Teresa di Riva e Sant’Alessio", z:"Santa Teresa di Riva", min:42, km:54.3, t:"mare", g:"nascosto", fo:"ciottoli", img:"santateresariva.jpg", piu:["santateresariva-2.jpg"], d:"Il tratto di costa tra Taormina e Messina, ignorato da tutti: spiagge di ciottoli lunghe e libere, con il capo di Sant’Alessio e il suo castello a picco sul mare. Da qui si sale a Savoca in dieci minuti."},
{b:4, n:"Forza d'Agrò", z:"Forza d'Agrò", min:44, km:48.6, t:"vedere", g:"nascosto", img:"forzadagro.jpg", d:"L'altro borgo del Padrino, a pochi minuti da Savoca. Vicoli stretti, castello in cima e una vista sullo Stretto che da sola vale la salita."},
{b:4, n:"Funivia dell'Etna", z:"Etna sud", min:44, km:28.1, t:"vedere", g:"", img:"funivia.jpg", d:"Sale a 2.500 m, poi fuoristrada con guida fino a ~2.900 m. È la parte cara della giornata: decidete voi se vale."},
{b:4, n:"Rifugio Sapienza e crateri Silvestri", z:"Etna sud, Nicolosi", min:44, km:28.1, t:"vedere", g:"top gratis", img:"etna.jpg", d:"Si arriva in auto a 1.900 m, parcheggio ampio. I crateri Silvestri si girano a piedi e gratis in mezz'ora. Paesaggio lunare. Se non volete spendere per la funivia, fermatevi qui: è già spettacolare. Felpa obbligatoria anche ad agosto."},
{b:4, n:"Castiglione di Sicilia", z:"Castiglione di Sicilia", min:46, km:43.8, t:"vedere spesa", g:"nascosto prenotare", img:"castiglione.jpg", d:"Uno dei Borghi più belli d'Italia, arroccato sopra la valle dell'Alcantara. È il cuore delle cantine dell'Etna nord: molte fanno degustazione su prenotazione."},
{b:4, n:"Lentini", z:"Lentini", min:47, km:48.1, t:"vedere spesa", g:"nascosto", d:"Città degli agrumi, con il museo archeologico e i resti della greca Leontinoi. Zona delle arance rosse: fuori stagione ad agosto, ma i prodotti trasformati si trovano tutto l'anno."},
{b:4, n:"Savoca", z:"Savoca", min:48, km:59.3, t:"vedere", g:"nascosto", img:"savoca.jpg", d:"Il borgo dove Coppola girò le scene siciliane del Padrino. Il Bar Vitelli è rimasto identico e la chiesa di San Nicolò è quella del matrimonio. Vista che spazia su tutta la costa."},
{b:4, n:"Agnone Bagni", z:"Augusta", min:49, km:49.2, t:"mare", g:"nascosto", fo:"sabbia", img:"agnone.jpg", d:"Lunga spiaggia sabbiosa tra Catania e Augusta, poco costruita e senza folla. Una delle poche sabbie libere di questo tratto di costa."},
{b:4, n:"Monti Sartorius", z:"Linguaglossa", min:50, km:37.5, t:"vedere", g:"gratis nascosto", img:"sartorius.jpg", d:"Fila di sette crateri allineati del 1865, con un sentiero ad anello facile di un'ora tra betulle e ginestre. Sul versante nord, gratis, e molto piu' tranquillo del Rifugio Sapienza."},
{b:4, n:"Piano Provenzana — Etna nord", z:"Linguaglossa", min:50, km:37.5, t:"vedere", g:"nascosto", img:"provenzana.jpg", d:"Versante alternativo, boscoso e molto meno affollato del sud. Se il Rifugio Sapienza vi sembra un parcheggio di pullman, la risposta è qui."},
{b:4, n:"Augusta", z:"Augusta", min:57, km:62.4, t:"vedere", g:"nascosto", img:"augusta.jpg", d:"Città costruita su un'isola fortificata e collegata da ponti, con il castello svevo di Federico II. Fuori da qualsiasi circuito turistico: ci si passa e non ci si ferma quasi mai."},
{b:4, n:"La Bitta Pescheria Gastronomica", z:"Augusta", min:57, km:62.4, t:"pesce street", g:"eco", d:"Pescheria che cucina: si sceglie il pesce al banco e lo si mangia sul posto. La formula più economica per mangiare pesce in zona."},
{b:4, n:"Megara Hyblaea", z:"Augusta", min:58, km:62.5, t:"vedere", g:"nascosto", img:"megara.jpg", d:"Colonia greca dell'VIII secolo a.C., tra le più antiche della Sicilia, con l'impianto urbano ancora leggibile a terra. Sta incastrata fra le raffinerie e proprio per questo non ci va nessuno: si gira quasi sempre da soli."},
{b:4, n:"Cantine dell'Etna", z:"Randazzo, Linguaglossa", min:59, km:54.9, t:"vedere spesa", g:"nascosto prenotare", img:"cantineetna.jpg", d:"L'Etna DOC nasce su terrazzamenti di lava ed è tra i vini italiani più cercati al mondo. Molte cantine fanno visita e degustazione su prenotazione. Chi guida assaggia poco: strade strette e tornanti."},
{b:4, n:"Randazzo", z:"Randazzo", min:59, km:54.9, t:"vedere", g:"nascosto", img:"randazzo.jpg", d:"Il borgo medievale meglio conservato dell'Etna, costruito interamente in pietra lavica nera. Scampato a tutte le colate, ha un centro storico che sembra un set."},
{b:4, n:"Brucoli", z:"Augusta", min:60, km:63.7, t:"mare vedere", g:"nascosto", fo:"scogli", img:"brucoli.jpg", piu:["brucoli-2.jpg","brucoli-3.jpg"], d:"Borgo di pescatori affacciato su un canale naturale che entra nella terraferma come un fiordo in miniatura, con il castello aragonese all'imbocco. Acqua trasparente e quasi nessuno."},
{b:4, n:"I Rizzari", z:"Brucoli, Augusta", min:60, km:63.7, t:"pesce", g:"top", a:"Via Libertà 63", d:"Terrazza affacciata sul mare e cucina tutta sulla freschezza: zuppe di pesce, vongole, ostriche, scampi, pescato alla griglia. La combinazione da fare è ai ricci di mare, prima il bruschettone e poi la pasta."},
{b:4, n:"La Cozza d’Oro", z:"Brucoli, Augusta", min:60, km:63.7, t:"pesce", g:"locali", a:"Via Libertà 118", d:"Trattoria-ristorante di paese: pesce fresco, molluschi e crostacei, senza scenografie."},
{b:5, n:"Faro di Capo Santa Croce", z:"Augusta", min:62, km:65, t:"vedere mare", g:"nascosto", fo:"scogli", img:"farosantacroce.jpg", piu:["farosantacroce-2.jpg","farosantacroce-3.jpg"], d:"Il faro sul promontorio che chiude la baia di Augusta, uno dei punti più a est della Sicilia. Scogliera bassa sotto, acqua trasparente e vista che arriva fino all'Etna."},
{b:5, n:"Bottega Novè", z:"Bronte", min:63, km:58.8, t:"spesa dolci", g:"top", img:"pistacchio.jpg", a:"Via San Pietro 37", d:"Filletta al pistacchio e pesto di Bronte DOP in barattolo: si conserva bene ed è il souvenir gastronomico migliore. Diffidate del pesto troppo economico altrove: spesso è pistacchio turco."},
{b:5, n:"Duomo di Messina", z:"Messina", min:63, km:81.2, t:"vedere", g:"", img:"messina.jpg", d:"Il campanile astronomico più grande del mondo si anima ogni giorno alle 12:00 in punto: leone ruggente, gallo, figure in movimento. Dura una decina di minuti."},
{b:5, n:"Gattopardo Boutique Pizzeria", z:"Messina", min:63, km:81.2, t:"pizza", g:"", a:"Via Santa Cecilia 188", d:"Pizza Sensory molto lodata, buona anche per gruppi numerosi."},
{b:5, n:"Il Siciliano", z:"Messina", min:63, km:81.2, t:"pizza", g:"eco", a:"Via G. Garibaldi 112", d:"Pizze grandi, ottimo rapporto qualità-prezzo, staff accogliente."},
{b:5, n:"L'Angolo dei Sapori", z:"Bronte", min:63, km:58.8, t:"street", g:"eco", d:"Street food col pistacchio: l'arancino nero al pistacchio è una variante che non trovate altrove."},
{b:5, n:"La Dolceria", z:"Messina", min:63, km:81.2, t:"dolci", g:"top", a:"Via Cesare Battisti 55", d:"I migliori cannoli, dice il nome. Cassata eccellente."},
{b:5, n:"La Fucina di Vulcano", z:"Bronte", min:63, km:58.8, t:"pasta", g:"", d:"Cucina siciliana col pistacchio protagonista, in chiave tradizionale."},
{b:5, n:"La Locanda del Carrettiere", z:"Bronte", min:63, km:58.8, t:"carne", g:"locali", d:"Cucina tipica brontese: carni alla brace e ricette familiari. Punta sulla sostanza, non sull'estetica."},
{b:5, n:"Lo Scialandro e il centro storico", z:"Bronte", min:63, km:58.8, t:"vedere", g:"nascosto", img:"brontecentro.jpg", d:"Vecchi quartieri di struttura araba, vicoli stretti e sottopassaggi caratteristici (u catoiu). Dall’inizio di Corso Umberto, allo Scialandro, panorama splendido sull’Etna."},
{b:5, n:"Pasticceria Del Duomo", z:"Messina", min:63, km:81.2, t:"dolci", g:"locali", a:"Via I Settembre 154", d:"Cannolo non troppo dolce, molto apprezzato dai locali."},
{b:5, n:"Pasticceria Irrera 1910", z:"Messina", min:63, km:81.2, t:"dolci", g:"", a:"Piazza Cairoli 12", d:"Storica: granita con brioche perfetta dopo il Duomo."},
{b:5, n:"Pasticceria Principe Panebianco", z:"Messina", min:63, km:81.2, t:"dolci", g:"locali", a:"Via Camaro 44", d:"Granita e brioche tra le migliori, con piparelle e nzulle, i biscotti tipici messinesi."},
{b:5, n:"Punta Izzo", z:"Augusta", min:63, km:64.6, t:"mare", g:"nascosto", fo:"scogli", d:"Costa rocciosa con calette e acqua limpidissima sulla penisola di Augusta. Parte dell'area è demanio militare e l'accesso può essere limitato: informatevi sul posto prima di incamminarvi."},
{b:5, n:"Semola Pizzeria Siciliana", z:"Messina", min:63, km:81.2, t:"pizza", g:"locali", a:"Via Camiciotti 14", d:"Molto frequentata dai messinesi la sera, che è sempre buon segno. Prezzi onesti."},
{b:5, n:"Shopping a Messina", z:"Messina", min:63, km:81.2, t:"spesa", g:"eco", d:"Via Garibaldi e Via I Settembre per catene e negozi pratici. Vicino al Duomo qualche souvenir e artigianato, a prezzi più onesti che a Taormina o Palermo."},
{b:5, n:"Urban Lescà", z:"Messina", min:63, km:81.2, t:"pizza", g:"locali", a:"Via Ghibellina 95", d:"Frequentato dai locali, apre quando gli altri sono ancora chiusi."},
{b:5, n:"Castello Eurialo", z:"Siracusa", min:64, km:74.4, t:"vedere", g:"nascosto", img:"eurialo.jpg", d:"La fortezza greca meglio conservata del Mediterraneo, costruita da Dionisio per difendere Siracusa. Fossati, torri e gallerie sotterranee percorribili. Fuori Ortigia, quindi quasi vuota, e la vista arriva fino al mare."},
{b:5, n:"Militello in Val di Catania", z:"Militello", min:67, km:62.7, t:"vedere dolci", g:"nascosto", img:"militello.jpg", d:"Uno degli otto comuni del barocco tardo della Val di Noto riconosciuti dall'UNESCO, e il meno visitato di tutti. Da provare le 'olivette di Sant'Agata' e la mostarda di fichidindia."},
{b:5, n:"Pasticceria Nuova Dolceria", z:"Siracusa", min:69, km:81.1, t:"dolci", g:"", a:"Corso Umberto I 18", d:"Aperitivi e dolci, buon punto di partenza prima di entrare a Ortigia."},
{b:5, n:"Teatro Greco e Neapolis", z:"Siracusa", min:69, km:81.1, t:"vedere", g:"", img:"teatro_siracusa.jpg", d:"Uno dei teatri più grandi del mondo antico, scavato nella roccia. Nel parco anche l'Orecchio di Dionisio."},
{b:5, n:"Museo Paolo Orsi", z:"Siracusa", min:70, km:81.9, t:"vedere", g:"", img:"orsi.jpg", d:"Uno dei musei archeologici più importanti d'Europa: tutto quello che è uscito dagli scavi della Sicilia orientale, dalla preistoria ai greci. Grande e con l'aria condizionata, che ad agosto non guasta."},
{b:5, n:"Penisola Magnisi (Thapsos)", z:"Priolo Gargallo", min:71, km:72.6, t:"mare vedere", g:"nascosto", fo:"scogli", img:"magnisi.jpg", d:"Lingua di terra con due spiagge, una per lato, e sopra il villaggio preistorico di Thapsos. Si arriva passando accanto alle saline coi fenicotteri."},
{b:5, n:"Saline di Priolo", z:"Priolo Gargallo", min:71, km:73.3, t:"vedere", g:"nascosto gratis", img:"priolo.jpg", d:"Riserva WWF incastrata tra le raffinerie, e proprio per questo poco battuta: ci sono i fenicotteri rosa, in Sicilia orientale è l'unico posto dove si vedono con regolarità. Capanni per l'osservazione, ingresso libero."},
{b:5, n:"Cala Rossa e Solarium Forte Vigliena", z:"Ortigia, Siracusa", min:72, km:82.7, t:"mare", g:"gratis", fo:"scogli", img:"ortigia_lungomare.jpg", d:"Bagno al volo in pieno centro storico, scendendo una scalinata dal lungomare. Il Solarium è gratuito, con docce e piattaforme in legno sugli scogli."},
{b:5, n:"Cannolo Terapia", z:"Ortigia, Siracusa", min:72, km:82.7, t:"dolci", g:"", a:"Via Pausania 3", d:"Anche versione senza glutine, granita al pistacchio eccellente."},
{b:5, n:"Castello Maniace", z:"Ortigia, Siracusa", min:72, km:82.7, t:"vedere", g:"", img:"maniace.jpg", d:"La fortezza sveva sulla punta estrema di Ortigia, circondata dal mare su tre lati. Il salone ipostilo con le colonne è la parte che vale il biglietto."},
{b:5, n:"da Carmelo", z:"Ortigia, Siracusa", min:72, km:82.7, t:"pizza", g:"eco", a:"Via del Crocefisso 44/46", d:"Pizza da 7,50€, polpette ottime, tiramisù tra i migliori di Ortigia."},
{b:5, n:"Duomo di Ortigia", z:"Ortigia, Siracusa", min:72, km:82.7, t:"vedere", g:"top", img:"duomoortigia.jpg", d:"Una cattedrale costruita dentro un tempio greco del V secolo a.C.: le colonne doriche originali sono ancora inglobate nei muri, si vedono da dentro e da fuori. Duemilacinquecento anni nello stesso edificio."},
{b:5, n:"Era Ora Ortigia", z:"Ortigia, Siracusa", min:72, km:82.7, t:"pizza", g:"top prenotare", a:"Riva Giuseppe Garibaldi 10", d:"Per molti la miglior pizza mangiata in Sicilia, punto. Prenotate con giorni di anticipo: si riempie subito."},
{b:5, n:"Fonte Aretusa", z:"Ortigia, Siracusa", min:72, km:82.7, t:"vedere", g:"", img:"aretusa.jpg", d:"Sorgente d'acqua dolce a due passi dal mare, con papiri spontanei: una rarità in Europa. Bellissima al tramonto."},
{b:5, n:"L'Antica Pizzeria da Michele Ortigia", z:"Ortigia, Siracusa", min:72, km:82.7, t:"pizza", g:"eco", a:"Riva della Posta 12a", d:"Filiale del marchio napoletano: pizze enormi e leggere."},
{b:5, n:"Mercato di Ortigia", z:"Ortigia, Siracusa", min:72, km:82.7, t:"spesa vedere", g:"locali eco", img:"mercatoortigia.jpg", d:"Ogni mattina fino alle 14: spezie, capperi, agrumi, formaggi, pomodori secchi. Ottimo per un souvenir gastronomico comprato d'istinto."},
{b:5, n:"Neri Maestro Alfio", z:"Ortigia, Siracusa", min:72, km:82.7, t:"dolci street", g:"locali", a:"Via Pausania 3", d:"Arancino al pistacchio e cannolo definiti tra i migliori assaggiati in assoluto."},
{b:5, n:"Ortigia — Piazza Duomo e i vicoli", z:"Ortigia, Siracusa", min:72, km:82.7, t:"vedere spesa", g:"", img:"ortigia.jpg", d:"L'isolotto storico: botteghe artigiane, ceramica, gioielleria in corallo. Si gira tutto a piedi."},
{b:5, n:"Pasticceria Artale", z:"Ortigia, Siracusa", min:72, km:82.7, t:"dolci", g:"top", a:"Via Saverio Landolina 32", d:"Granita al pistacchio tra le migliori di tutta la Sicilia, cannolo non troppo dolce."},
{b:5, n:"Pizzeria Anima e Core", z:"Ortigia, Siracusa", min:72, km:82.7, t:"pizza", g:"", a:"Via Claudio Mario Arezzo 9", d:"Vero stile napoletano, bufala affumicata da provare."},
{b:5, n:"Tempio di Apollo", z:"Ortigia, Siracusa", min:72, km:82.7, t:"vedere", g:"gratis", img:"tempioapollo.jpg", d:"Il tempio dorico piu' antico della Sicilia, VI secolo a.C., in mezzo alla piazza appena entrati a Ortigia. Si vede dalla strada, gratis, ed e' la prima cosa che incontrate passando il ponte."},
{b:5, n:"Laghi di Ganzirri", z:"Messina", min:73, km:90.7, t:"mare vedere", g:"nascosto", img:"ganzirri.jpg", piu:["ganzirri-2.jpg","ganzirri-3.jpg"], d:"Due laghi salati collegati al mare dove si allevano cozze e vongole da secoli. Sul lungolago si mangia pesce con i tavoli sull'acqua."},
{b:5, n:"Spiaggia del Gelsomineto", z:"Avola", min:73, km:90.3, t:"mare", g:"nascosto top", fo:"sabbia", img:"gelsomineto.jpg", d:"Cala di sabbia chiara chiusa tra due promontori, si scende da un sentiero e non c’è niente intorno: nessun lido, nessun bar. Per molti la più bella della costa tra Siracusa e Avola."},
{b:5, n:"Fontane Bianche", z:"Siracusa sud", min:76, km:90.7, t:"mare", g:"", fo:"sabbia", img:"fontanebianche.jpg", piu:["fontanebianche-3.jpg"], d:"La spiaggia sabbiosa più attrezzata della zona: lidi, ristoranti, pedalò e SUP. La sabbia vera più vicina alla vostra base."},
{b:5, n:"Torre Faro e Capo Peloro", z:"Messina", min:77, km:94.2, t:"mare vedere", g:"nascosto", fo:"ciottoli", img:"torrefaro.jpg", piu:["torrefaro-2.jpg","torrefaro-3.jpg"], d:"La punta estrema della Sicilia, dove Ionio e Tirreno si toccano e si vede la Calabria a tre chilometri. Spiaggia di ciottoli, il pilone dell'elettrodotto e le correnti che rendono l'acqua sempre limpida."},
{b:5, n:"Mortelle", z:"Messina", min:78, km:95.1, t:"mare", g:"", fo:"sabbia", d:"La spiaggia dei messinesi sul versante tirrenico: sabbia, lidi attrezzati e locali serali."},
{b:5, n:"Arenella", z:"Siracusa", min:79, km:89.4, t:"mare", g:"", fo:"sabbia", img:"arenella.jpg", piu:["arenella-3.jpg"], d:"Alternativa a Fontane Bianche: fondali bassi, lidi e aree libere."},
{b:5, n:"Castello di Nelson", z:"Maniace, Bronte", min:79, km:73.9, t:"vedere", g:"", img:"nelson.jpg", d:"Dimora dell'ammiraglio Nelson, oggi museo, con vista sull'Etna e sulle campagne di pistacchio. Il parco è uno dei pochi posti freschi della zona ad agosto."},
{b:5, n:"Avola", z:"Avola", min:80, km:96.9, t:"vedere spesa", g:"", img:"avola.jpg", d:"Città barocca a pianta esagonale, ricostruita dopo il 1693. Patria della mandorla di Avola, la più pregiata d'Italia, e del vitigno Nero d'Avola: entrambe si comprano qui a prezzi che altrove non trovate."},
{b:5, n:"Ci:Vulia", z:"Avola", min:80, km:96.9, t:"pesce", g:"", a:"Via Elsa Morante 2", d:"Cucina creativa sul pesce fresco. Ravioli dello chef con pistacchio (13&euro;), scrigno di frutti di mare (16&euro;)."},
{b:5, n:"DéjàVu Bar Restaurant", z:"Avola", min:80, km:96.9, t:"pesce pasta", g:"", a:"Piazza Vittorio Veneto 29", d:"Nel cuore del centro storico, dentro un cortile caratteristico. Menu che cambia con le stagioni: baccalà con pera sciroppata (14&euro;), spaghetti con ostriche (18&euro;)."},
{b:5, n:"Giufà Bistrot", z:"Avola", min:80, km:96.9, t:"pesce", g:"", a:"Via Elsa Morante 30", d:"Tradizione siciliana in chiave innovativa. Il polpo Don Carmelo servito su pietra lavica (13&euro;) è il piatto che lo identifica."},
{b:5, n:"La Corte D’Aragona", z:"Avola", min:80, km:96.9, t:"pasta pesce", g:"", a:"Piazza Umberto I 43", d:"Piatti tipici rivisitati in piazza: ravioli melanzana e scamorza (13&euro;), risotto gamberi e bottarga (14&euro;)."},
{b:5, n:"La Scogliera", z:"Avola", min:80, km:96.9, t:"pesce pizza", g:"eco", a:"Via Aldo Moro 121", d:"Pesce fresco e pizza nello stesso menu: ravioli di pesce con pistacchio (16&euro;), pesce spada in crosta di mandorle (15&euro;). Comodo se il gruppo non si mette d'accordo."},
{b:5, n:"Lido di Avola", z:"Avola", min:80, km:96.9, t:"mare", g:"", fo:"sabbia", img:"lidoavola.jpg", piu:["lidoavola-2.jpg"], d:"La spiaggia della città, sabbiosa e attrezzata, con la pineta alle spalle. Comoda se siete già ad Avola per la mandorla o il barocco."},
{b:5, n:"Portomatto", z:"Avola", min:80, km:96.9, t:"pizza pesce", g:"", a:"Via Sandro Pertini 43", d:"Pizza con farina locale Tumminìa, grano antico siciliano, e cucina di pesce. Risotto al latte di mandorla con pesce spada affumicato (14&euro;)."},
{b:5, n:"Ristorante La Prua", z:"Avola", min:80, km:96.9, t:"pesce", g:"top", a:"Viale P. Mattarella 12", d:"A pochi passi dal mare, con la struttura che ricorda la prua di una nave. Pesce con rivisitazioni moderne: l'antipasto della prua (14&euro;) e il risotto al Nero d'Avola con mandorle (12&euro;), cioè i due prodotti del posto nello stesso piatto."},
{b:5, n:"Spiaggia del Minareto", z:"Siracusa", min:80, km:88, t:"mare", g:"nascosto", fo:"scogli", img:"minareto.jpg", d:"Si raggiunge a piedi con sentiero e scalinata, o in barca. Libera, con un lido a fianco per chi vuole i servizi."},
{b:5, n:"Enna e il Castello di Lombardia", z:"Enna", min:85, km:101.1, t:"vedere", g:"nascosto", img:"enna.jpg", d:"Il capoluogo più alto d'Italia, a 931 metri, in mezzo all'isola. Dal Castello di Lombardia si vede mezza Sicilia e in una giornata limpida anche l'Etna per intero. D'agosto è l'unico posto dove si respira."},
{b:5, n:"Plemmirio", z:"Penisola della Maddalena", min:85, km:91.6, t:"mare", g:"nascosto", fo:"scogli", img:"plemmirio.jpg", piu:["plemmirio-2.jpg","plemmirio-3.jpg"], d:"Area Marina Protetta: falesie, grotte e calette con fondali tra i più belli del Mediterraneo. Il posto giusto per lo snorkeling, portate maschera."},
{b:5, n:"Caltagirone", z:"Caltagirone", min:86, km:86.9, t:"vedere spesa", g:"top", img:"caltagirone.jpg", d:"Capitale della ceramica siciliana. La scalinata di Santa Maria del Monte è fatta di 142 gradini, ognuno decorato con maioliche diverse. Le teste di Moro le comprate qui, alla fonte."},
{b:5, n:"Noto", z:"Noto", min:88, km:105.5, t:"vedere", g:"top", img:"noto.jpg", d:"Ricostruita da zero dopo il terremoto del 1693, tutta in pietra calcarea dorata: al tramonto la città diventa arancione. È solo 40 minuti oltre Siracusa. Gelato di Caffè Sicilia, tra i più famosi d'Italia."},
{b:5, n:"Palazzo Nicolaci e Via Corrado Nicolaci", z:"Noto", min:88, km:105.5, t:"vedere", g:"", img:"nicolaci.jpg", d:"I balconi retti da cavalli, sirene e mascheroni scolpiti: il pezzo di barocco piu' fotografato di Noto. A maggio la via si copre di fiori per l'Infiorata, ma i balconi ci sono tutto l'anno."},
{b:5, n:"Lido di Noto", z:"Noto Marina", min:90, km:105.2, t:"mare", g:"", fo:"sabbia", img:"notomarina.jpg", d:"La spiaggia di Noto, sabbiosa e attrezzata, a un quarto d'ora dal centro barocco. Comoda per unire mare e città nella stessa giornata."},
{b:5, n:"Villa Romana del Tellaro", z:"Noto", min:91, km:107.8, t:"vedere", g:"nascosto", img:"tellaro.jpg", d:"Villa romana con mosaici del IV secolo, sorella minore e molto meno affollata di quella di Piazza Armerina. Si abbina bene a Noto o a Vendicari."},
{b:5, n:"Milazzo — porto per le Eolie", z:"Milazzo", min:92, km:117.6, t:"vedere mare", g:"", img:"milazzo.jpg", d:"Da qui partono gli aliscafi per Vulcano e Lipari: circa 40 minuti di traversata. Se volete vedere le Eolie in giornata è l'unico imbarco sensato, ma è una giornata lunga."},
{b:6, n:"Riserva di Vendicari e Calamosche", z:"Noto", min:96, km:111.8, t:"mare vedere", g:"nascosto", fo:"sabbia", img:"vendicari.jpg", piu:["vendicari-2.jpg"], d:"Riserva con pantani, fenicotteri e la vecchia tonnara sul mare. La spiaggia di Calamosche, incastrata tra due promontori, si raggiunge solo con venti minuti a piedi ed è regolarmente tra le più belle d'Italia."},
{b:6, n:"Palazzolo Acreide", z:"Palazzolo Acreide", min:101, km:96.5, t:"vedere", g:"nascosto", img:"palazzolo.jpg", d:"Altro comune UNESCO della Val di Noto, con sopra il teatro greco di Akrai, piccolo ma intatto, e i Santoni, rilievi rupestri della dea Cibele scolpiti nella roccia. Zona della salsiccia di Palazzolo, presidio Slow Food."},
{b:6, n:"Tindari e i Laghetti di Marinello", z:"Tindari", min:103, km:138.3, t:"vedere mare", g:"nascosto", fo:"sabbia", img:"tindari.jpg", piu:["tindari-2.jpg","tindari-3.jpg"], d:"Santuario a picco su un promontorio, con sotto il teatro greco e le lagune di Marinello, che cambiano forma a ogni mareggiata. La vista dall'alto sulle lingue di sabbia è una delle più fotografate della costa nord."},
{b:6, n:"Cava Grande del Cassibile", z:"Avola", min:105, km:98.9, t:"vedere mare", g:"nascosto", fo:"ciottoli", img:"cavagrande.jpg", piu:["cavagrande-2.jpg","cavagrande-3.jpg"], d:"Canyon profondo con una fila di laghetti color smeraldo sul fondo, dove si fa il bagno. La discesa è ripida e lunga: si scende in mezz'ora e si risale in un'ora abbondante. Portate acqua e non fatelo nelle ore calde."},
{b:6, n:"Spiaggia di San Lorenzo", z:"Noto", min:105, km:118.1, t:"mare", g:"top", fo:"sabbia", img:"sanlorenzo.jpg", d:"Sabbia bianchissima e acqua bassa e trasparente per decine di metri: una delle più belle di tutto il sud-est, e a due passi da Marzamemi. Lidi e ampi tratti liberi."},
{b:6, n:"Cantine del Nero d’Avola", z:"Pachino", min:107, km:121.6, t:"spesa", g:"nascosto prenotare", d:"La zona di Pachino e Portopalo e' la patria del Nero d'Avola e del Moscato di Noto. Diverse cantine fanno visita e degustazione su prenotazione, a prezzi molto piu' bassi che sull'Etna."},
{b:6, n:"Grotta Calafarina", z:"Pachino", min:107, km:121.6, t:"vedere", g:"nascosto", img:"calafarina.jpg", d:"Grotta naturale nella campagna di Pachino, verso il mare, abitata fin dalla preistoria: ci sono stati trovati reperti del Paleolitico e del Neolitico. Non e’ attrezzata e non e’ segnalata, ma e’ una delle poche cose da vedere in zona oltre alle spiagge."},
{b:6, n:"I Curtigghiari", z:"Pachino", min:107, km:121.6, t:"pesce pasta", g:"locali", d:"Pesce e piatti tipici del posto: ravioli di cernia e spiedini di pesce con panatura di pistacchi."},
{b:6, n:"Pachino", z:"Pachino", min:107, km:121.6, t:"spesa", g:"", img:"pachino.jpg", d:"Il pomodoro di Pachino IGP nasce qui, e qui costa una frazione di quello che pagate al nord. Zona anche di Nero d'Avola e Moscato."},
{b:6, n:"Tasca", z:"Pachino", min:107, km:121.6, t:"carne", g:"", a:"Via Cavour", d:"L'alternativa alla carne quando avete mangiato pesce per tre giorni: cube roll di manzo, costine in salsa bbq."},
{b:6, n:"Villa Romana del Casale", z:"Piazza Armerina", min:108, km:116.8, t:"vedere", g:"top", img:"piazzaarmerina.jpg", d:"I mosaici romani meglio conservati al mondo, 3.500 metri quadri, patrimonio UNESCO. C'è la celebre scena delle ragazze in bikini. È più vicina di Palermo e nel documento di partenza non c'era: se dovete scegliere una sola gita lunga, probabilmente è questa."},
{b:6, n:"Il Boccone", z:"Marzamemi, Pachino", min:110, km:123, t:"pasta pesce", g:"", d:"Da provare gli spaghetti alla Gattopardo, con pesto di pistacchi e bottarga."},
{b:6, n:"La Locanda del Porto", z:"Marzamemi, Pachino", min:110, km:123, t:"pesce", g:"", d:"Sushi e pesce crudo, sashimi di tonno. Il tonno qui non arriva da lontano: la tonnara è quella accanto."},
{b:6, n:"Marzamemi", z:"Marzamemi, Pachino", min:110, km:123, t:"vedere pesce", g:"nascosto", img:"marzamemi.jpg", d:"Ex tonnara con una piazzetta di tufo affacciata sul mare. La sera si cena all'aperto tra le case basse. A pochi minuti dalle spiagge di Vendicari."},
{b:6, n:"Sama", z:"Marzamemi, Pachino", min:110, km:123, t:"pesce", g:"", d:"Crudità di mare: ostriche, scampi, gamberi rossi. Per chi vuole il pesce senza cottura."},
{b:6, n:"Spiaggia della Spinazza", z:"Marzamemi, Pachino", min:110, km:123, t:"mare", g:"", fo:"sabbia", img:"spinazza.jpg", d:"La spiaggia di Marzamemi, sabbia dorata subito fuori dal borgo. Comoda: si fa il bagno e poi si cena nella piazzetta di tufo a piedi."},
{b:6, n:"Tonnara e Palazzo di Villadorata", z:"Marzamemi, Pachino", min:110, km:123, t:"vedere", g:"top", img:"tonnara.jpg", d:"La tonnara del Seicento e il palazzo dei principi di Villadorata affacciati sulla piazzetta di tufo. Il borgo e' nato tutto intorno a questo: le case basse dei pescatori sono ancora quelle."},
{b:6, n:"Trattoria La Cialoma", z:"Marzamemi, Pachino", min:110, km:123, t:"pesce pasta", g:"top", a:"Sulla piazzetta di tufo", d:"Il tavolo giusto nella piazzetta più fotografata della Sicilia. Cous cous al pesto con gamberi crudi e involtini di melanzane in agrodolce."},
{b:6, n:"Ispica", z:"Ispica", min:111, km:126.4, t:"vedere", g:"", img:"ispica.jpg", d:"Ultimo degli otto comuni UNESCO della Val di Noto, con la Basilica di Santa Maria Maggiore e il loggiato del Sinatra."},
{b:6, n:"Morghella", z:"Pachino", min:112, km:125.3, t:"mare", g:"nascosto", fo:"sabbia", d:"Cala di sabbia e scogli bassi tra Pachino e Portopalo, con l'acqua che resta bassa a lungo. Poco battuta, ci si arriva da stradine di campagna."},
{b:6, n:"Duomo di San Giorgio", z:"Ragusa", min:113, km:113.3, t:"vedere", g:"", img:"sangiorgioragusa.jpg", d:"La facciata a torre di Rosario Gagliardi in cima a una scalinata, dentro Ibla. Il capolavoro del barocco ibleo e la cartolina di Ragusa."},
{b:6, n:"Ragusa Ibla", z:"Ragusa", min:113, km:113.3, t:"vedere", g:"", img:"ragusaibla.jpg", d:"Labirinto di vicoli sospeso su uno sperone di roccia. La vista dal Giardino Ibleo vale la strada."},
{b:6, n:"Granelli", z:"Pachino", min:115, km:128.1, t:"mare", g:"nascosto", fo:"sabbia", d:"Spiaggia di sabbia fine con dune basse e vento quasi sempre presente: qui vengono i kitesurfer. Poco costruita, niente folla."},
{b:6, n:"Isola di Capo Passero e il Forte", z:"Portopalo di Capo Passero", min:116, km:127.7, t:"mare vedere", g:"nascosto", fo:"scogli", img:"capopassero.jpg", piu:["capopassero-2.jpg","capopassero-3.jpg"], d:"Isolotto raggiungibile a piedi guadando l'acqua bassa quando il mare e' calmo, con sopra il forte spagnolo del Cinquecento e la macchia mediterranea. Riserva naturale."},
{b:6, n:"La Taverna dei Due Mari", z:"Portopalo di Capo Passero", min:116, km:127.7, t:"pesce pizza", g:"", a:"Via Maucini 65", d:"Ristorante e pizzeria specializzato in pesce fresco, a due passi dall'Isola delle Correnti."},
{b:6, n:"Portopalo di Capo Passero", z:"Portopalo di Capo Passero", min:116, km:127.7, t:"mare vedere", g:"nascosto", fo:"sabbia", img:"portopalo.jpg", d:"Il paese più a sud della Sicilia continentale, più a sud di Tunisi. Porto di pescatori, tonnara e l'isolotto di Capo Passero raggiungibile a piedi nell'acqua bassa."},
{b:6, n:"Ristorante Il Moro", z:"Portopalo di Capo Passero", min:116, km:127.7, t:"pesce", g:"", d:"Uno dei nomi storici del paese per il pesce. Zona di tonno fresco, bottarga e pesce spada."},
{b:6, n:"Spiaggia di Carratois", z:"Portopalo di Capo Passero", min:116, km:127.7, t:"mare", g:"", fo:"sabbia", d:"Sabbia chiara e fondale basso vicino all'Isola delle Correnti, riparata dal vento quando dall'altra parte tira troppo."},
{b:6, n:"Trattoria La Caverna del Cico", z:"Portopalo di Capo Passero", min:116, km:127.7, t:"pesce", g:"locali", a:"Sulla via che scende al porto", d:"Si mangia il pescato del giorno, senza menu fisso. Pasta con canocchie e gamberoni."},
{b:6, n:"U Palangaru", z:"Portopalo di Capo Passero", min:116, km:127.7, t:"pesce", g:"top", a:"Sul corso principale", d:"Pesce alla griglia e ravioli di cernia con pesto di pistacchi. Da chiudere col gelo al limone."},
{b:6, n:"Zibibbo", z:"Portopalo di Capo Passero", min:116, km:127.7, t:"pesce", g:"", d:"Cucina tipica più raffinata: gamberi rossi su gazpacho di datterini, spaghetti ai gamberi."},
{b:6, n:"Spiaggia di Pozzallo", z:"Pozzallo", min:117, km:131.9, t:"mare", g:"eco", fo:"sabbia", img:"pozzallospiaggia.jpg", piu:["pozzallospiaggia-2.jpg"], d:"Sabbia fine e fondale basso, bandiera blu, con la torre Cabrera sul lungomare. A fine agosto c’è la Sagra del Pesce."},
{b:6, n:"Cava d’Ispica", z:"Ispica", min:121, km:130.5, t:"vedere", g:"nascosto", img:"cavadispica.jpg", d:"Canyon lungo tredici chilometri scavato di grotte: necropoli preistoriche, catacombe e case rupestri abitate fino al Novecento. Si visita solo una parte, ma è impressionante."},
{b:6, n:"Marina di Marza e i Faraglioni di Ciriga", z:"Ispica", min:122, km:133.2, t:"mare", g:"nascosto", fo:"sabbia", img:"marzamare.jpg", d:"Piccola baia di sabbia tra gli scogli, molto locale. Alternativa raccolta al Focallo che le sta accanto."},
{b:6, n:"Santa Maria del Focallo", z:"Ispica", min:122, km:133, t:"mare", g:"eco", fo:"sabbia", img:"focallo.jpg", piu:["focallo-2.jpg","focallo-3.jpg"], d:"Otto chilometri di sabbia fine con dune e macchia mediterranea, bandiera blu. Una delle spiagge più lunghe della Sicilia e mai davvero affollata."},
{b:6, n:"Isola delle Correnti", z:"Portopalo di Capo Passero", min:126, km:130.9, t:"mare", g:"nascosto", fo:"sabbia", img:"isolacorrenti.jpg", piu:["isolacorrenti-2.jpg","isolacorrenti-3.jpg"], d:"La punta estrema dell'isola, dove lo Ionio e il Mediterraneo si incontrano visibilmente: due mari di colore diverso che si toccano. Vento quasi sempre, ottimo per il kite, meno per l'ombrellone."},
{b:6, n:"Antica Dolceria Bonajuto", z:"Modica", min:128, km:146.3, t:"dolci spesa", g:"top", a:"Corso Umberto I 159", d:"La cioccolateria piu' antica della Sicilia, dal 1880, e quella che ha tenuto in vita il metodo azteco a freddo. Da provare il cioccolato alla cannella e le 'mpanatigghi, biscotti con dentro la carne di manzo."},
{b:6, n:"Modica", z:"Modica", min:128, km:146.3, t:"vedere dolci", g:"", img:"modica.jpg", d:"Città su due livelli arrampicata in una gola. Soprattutto: il cioccolato di Modica, lavorato a freddo col metodo azteco, granuloso e senza burro di cacao. Antica Dolceria Bonajuto dal 1880."},
{b:6, n:"Sampieri e la Fornace Penna", z:"Sampieri", min:132, km:144, t:"mare vedere", g:"nascosto", fo:"sabbia", img:"sampieri.jpg", piu:["sampieri-2.jpg","sampieri-3.jpg"], d:"Spiaggia di sabbia chiara lunga chilometri, con dietro lo scheletro della Fornace Penna, la fabbrica bruciata nel 1924 che nella serie di Montalbano è la Mànnara."},
{b:6, n:"Scicli", z:"Scicli", min:135, km:152.3, t:"vedere", g:"", img:"scicli.jpg", d:"Barocco UNESCO incastrato tra tre gole, e il commissariato di Montalbano nella serie. Meno affollata di Noto e Ragusa."},
{b:6, n:"Marina di Ragusa", z:"Marina di Ragusa", min:136, km:138.6, t:"mare", g:"", fo:"sabbia", img:"marinaragusa.jpg", d:"Spiaggia lunga e attrezzata con un lungomare vivo la sera. È il mare di riferimento della zona di Ragusa."},
{b:6, n:"Valle dei Templi", z:"Agrigento", min:139, km:174.6, t:"vedere", g:"top", img:"agrigento.jpg", d:"Otto templi dorici in fila su un crinale: il sito archeologico greco più grande del mondo, patrimonio UNESCO. Ad agosto conviene la visita serale, quando i templi sono illuminati e la temperatura è umana."},
{b:7, n:"San Leone", z:"Agrigento", min:142, km:175.9, t:"mare", g:"", fo:"sabbia", img:"sanleone.jpg", piu:["sanleone-2.jpg"], d:"La spiaggia di Agrigento, lunga e attrezzata, a dieci minuti dalla Valle dei Templi. Utile per spezzare la giornata se scendete fin lì."},
{b:7, n:"Donnalucata", z:"Scicli", min:145, km:159.6, t:"mare", g:"", fo:"sabbia", img:"donnalucata.jpg", piu:["donnalucata-2.jpg"], d:"Borgo di pescatori con il porticciolo e la spiaggia lunga accanto. La mattina presto si vede il pesce che sbarca."},
{b:7, n:"Cefalù", z:"Cefalù", min:152, km:195.1, t:"vedere mare", g:"", fo:"sabbia", img:"cefalu.jpg", d:"Borgo medievale con la spiaggia sotto la Rocca. Perfetto se decidete di spostare la base per una o due notti."},
{b:7, n:"Corso Ruggero e lungomare", z:"Cefalù", min:152, km:195.1, t:"spesa", g:"", img:"corsoruggero.jpg", d:"Ceramiche, tessuti siciliani e artigianato nel borgo medievale, con vista sulla Rocca. Sul lungomare bancarelle e souvenir più semplici."},
{b:7, n:"Da Sasà", z:"Cefalù", min:152, km:195.1, t:"pizza pesce", g:"", a:"Via Giudecca 58", d:"Sulla scogliera vicino al porto: napoletana, pesce e pasta."},
{b:7, n:"Il Cappero", z:"Cefalù", min:152, km:195.1, t:"pesce", g:"vista", a:"Via Vitaliano Brancati 50", d:"Vista mare dalla collina, orto proprio in loco, cannolo destrutturato."},
{b:7, n:"IL LOCALE Cefalù", z:"Cefalù", min:152, km:195.1, t:"pizza", g:"prenotare", a:"Via G. Amendola 6", d:"Pizza contemporanea, impasto tra i migliori della zona. Prenotare."},
{b:7, n:"Triscele Restaurant", z:"Cefalù", min:152, km:195.1, t:"pesce pasta", g:"top", a:"Via Umberto I 34", d:"Fiori di zucca, fusilloni con cozze, polpo. Considerato il migliore della città."},
{b:7, n:"Scala dei Turchi", z:"Realmonte", min:154, km:184.9, t:"mare vedere", g:"", fo:"scogli", img:"scaladeiturchi.jpg", piu:["scaladeiturchi-3.jpg"], d:"Falesia bianca di marna che scende al mare a gradoni naturali, a mezz'ora dalla Valle dei Templi. Attenzione: l'accesso alla scogliera è stato più volte chiuso per tutela, informatevi prima di partire."},
{b:7, n:"Antica Focacceria San Francesco", z:"Palermo", min:174, km:223.3, t:"street", g:"", a:"Via A. Paternostro", d:"Dal 1834. Pane ca meusa e sfincione, istituzione assoluta in una piazza bellissima. Molto turistica ormai, ma regge."},
{b:7, n:"Assud a Santamarina", z:"Palermo", min:174, km:223.3, t:"pizza", g:"", a:"Via del Celso 5", d:"Pizzeria siciliana tradizionale, lo staff spiega la tradizione."},
{b:7, n:"Barresi Osteria della Carne", z:"Palermo", min:174, km:223.3, t:"carne", g:"", a:"Via Isidoro La Lumia 48", d:"Si sceglie il taglio direttamente al bancone. Carpaccio generoso, Norma ottima."},
{b:7, n:"BIGA Genio e Farina", z:"Palermo", min:174, km:223.3, t:"street pizza", g:"eco", a:"Via Maqueda 284-286", d:"Pizza al trancio con tante varianti: perfetto per assaggiare molto spendendo poco."},
{b:7, n:"Cannoli — Via Maqueda", z:"Palermo", min:174, km:223.3, t:"dolci", g:"", a:"Via Maqueda 266", d:"Cannolo classico e granita di gelsi da provare assolutamente."},
{b:7, n:"Cassaro Bottega Alimentare", z:"Palermo", min:174, km:223.3, t:"spesa", g:"", a:"Via Vittorio Emanuele 415", d:"Taglieri, salumi, formaggi, ottimo anche per un aperitivo sul posto."},
{b:7, n:"Ciccio in Pentola", z:"Palermo", min:174, km:223.3, t:"carne pesce", g:"", a:"Via dello Spasimo 44", d:"Agnello cotto lento, ottimo anche il pesce. Fascia alta ma di livello."},
{b:7, n:"Di Peri Steakhouse", z:"Palermo", min:174, km:223.3, t:"carne", g:"top", a:"Piazza Don Bosco 8", d:"4,8 stelle, tra le migliori bistecche di Palermo: rib eye all'osso servito ancora sfrigolante."},
{b:7, n:"Dolce Capo", z:"Palermo", min:174, km:223.3, t:"dolci", g:"eco", a:"Via dei Candelai 95/97", d:"Ottimo pistacchio a prezzi onesti."},
{b:7, n:"Fùnnaco PizzaLab", z:"Palermo", min:174, km:223.3, t:"pizza", g:"top prenotare", a:"Via Pantelleria 19", d:"Tra le pizzerie migliori di Palermo. Si riempie subito."},
{b:7, n:"I Segreti del Chiostro", z:"Palermo", min:174, km:223.3, t:"dolci", g:"top", a:"Piazza Bellini 33", d:"Cannoli enormi dentro un ex monastero, con ricette di pasticceria conventuale recuperate dalle monache."},
{b:7, n:"KePalle", z:"Palermo", min:174, km:223.3, t:"street", g:"locali eco", d:"Citato da forum e chef palermitani specificamente per gli arancini. Più punti in città, amato dai residenti."},
{b:7, n:"Macelleria di Davì Antonino", z:"Palermo", min:174, km:223.3, t:"carne", g:"eco", a:"Viale Michelangelo 305/307", d:"Macelleria con angolo gastronomia: anelletti al forno e caponata da provare."},
{b:7, n:"Macelleria Sparacello", z:"Palermo", min:174, km:223.3, t:"carne", g:"eco", a:"Corso dei Mille 921/E", d:"Ottima qualità, anche panini gourmet da asporto."},
{b:7, n:"Mandorla & Ficodindia", z:"Palermo", min:174, km:223.3, t:"spesa", g:"", a:"Via Vittorio Emanuele 339", d:"Vi fanno assaggiare prima di comprare: paste di mandorla e liquori tipici."},
{b:7, n:"Mastunicola", z:"Palermo", min:174, km:223.3, t:"pizza", g:"", a:"Via Venezia 71", d:"Calzone leggerissimo, tra i più lodati in città."},
{b:7, n:"Mercato del Capo e Ballarò", z:"Palermo", min:174, km:223.3, t:"street vedere", g:"top locali eco", img:"ballaro.jpg", d:"Arancine, panelle, cazzilli, patacalzone e stigghiola alla brace. Cercate il banco di Riccardo 'u Re rì stigghiole', venditore di terza generazione: chiedete in giro, lo conoscono tutti."},
{b:7, n:"Nino 'u Ballerino", z:"Palermo", min:174, km:223.3, t:"street", g:"creator eco", a:"Corso Camillo Finocchiaro Aprile 76/78", d:"Pani ca meusa tra i più famosi di Palermo a prezzo onestissimo: meusa, arancino e acqua sui 5€ totali. Arancine a 2,50€."},
{b:7, n:"Nni Franco u' Vastiddaru", z:"Palermo", min:174, km:223.3, t:"street", g:"locali eco", a:"Via Vittorio Emanuele 102", d:"Vera rosticceria da locali: pane ca meusa, panelle, insalata di mare. Terrazza vicino a una fontana, prezzi popolari."},
{b:7, n:"Osteria Salutami a' Nonna", z:"Palermo", min:174, km:223.3, t:"pasta", g:"", a:"Piazza Conte Federico 24", d:"Cacio e pepe con tartare di gamberi, spaghetti alle cozze. 10-15€ a piatto."},
{b:7, n:"Pasticceria Cappello", z:"Palermo", min:174, km:223.3, t:"dolci", g:"locali", a:"Via Colonna Rotta 68", d:"Cannolo tra i migliori, sfogliata alla ricotta ottima."},
{b:7, n:"Pasticceria Costa", z:"Palermo", min:174, km:223.3, t:"dolci", g:"creator", a:"Via Maqueda 174, Quattro Canti", d:"Cannolo farcito al momento, cassata da provare. Tra i tre migliori cannoli assaggiati da molti in tutta la Sicilia."},
{b:7, n:"Pasticceria Tomasino", z:"Palermo", min:174, km:223.3, t:"spesa dolci", g:"", a:"Corso dei Mille 848", d:"Paste di mandorla ben confezionate per il viaggio di ritorno."},
{b:7, n:"PATORNO Macelleria & Steakhouse", z:"Palermo", min:174, km:223.3, t:"carne", g:"", a:"Viale SS. Maria Mediatrice 5", d:"Filetto dry aged, ambiente intimo, qualità della carne top."},
{b:7, n:"Pizzeria Frida", z:"Palermo", min:174, km:223.3, t:"pizza", g:"", a:"Piazza Sant'Onofrio 37/38", d:"Calzoni, sfincione, napoletana: menù ampissimo."},
{b:7, n:"Q-Tuppo", z:"Palermo", min:174, km:223.3, t:"dolci", g:"locali", a:"Corso Calatafimi 9", d:"La brioche per granita più votata della città."},
{b:7, n:"Quattro Canti e Cattedrale", z:"Palermo", min:174, km:223.3, t:"vedere", g:"", img:"palermo_cattedrale.jpg", d:"L'incrocio barocco che divide la città in quattro mandamenti, e una cattedrale che mescola arabo, normanno e neoclassico. Si sale sui tetti."},
{b:7, n:"Sardina PastaBar", z:"Palermo", min:174, km:223.3, t:"pesce", g:"prenotare", a:"Via dei Cassari 41/43", d:"Pesce fresco e pasta curata, fascia più alta. Prenotare."},
{b:7, n:"Shopping a Palermo", z:"Palermo", min:174, km:223.3, t:"spesa", g:"", d:"Via Ruggero Settimo e Via della Libertà per le catene (Zara, H&M, Bershka) e i negozi eleganti; Via Maqueda per i negozietti indipendenti e lo streetwear; Ballarò e Vucciria per i mercatini vintage, pezzi economici e particolari."},
{b:7, n:"Spinnato", z:"Palermo", min:174, km:223.3, t:"dolci", g:"creator", a:"Piazza Castelnuovo 16, Politeama", d:"Aperta dal 1860 davanti al Teatro Politeama. Dolce, salato e gelato molto apprezzato."},
{b:7, n:"Terzo Cerchio Gelateria", z:"Palermo", min:174, km:223.3, t:"dolci", g:"", a:"Via Maqueda 415", d:"Gelato top, gusto Sette Veli da non perdere."},
{b:7, n:"Trattoria Calessino", z:"Palermo, Mercato Ballarò", min:174, km:223.3, t:"pasta", g:"locali eco", a:"Via Giovanni Naso 5", d:"Pasta con ragù, prezzi giusti, atmosfera genuina in mezzo al mercato."},
{b:7, n:"Trattoria Il Bersagliere", z:"Palermo, zona Ballarò", min:174, km:223.3, t:"pasta", g:"locali eco", d:"Citata da chi vive Palermo tutti i giorni: cucina siciliana diretta, senza scenografie, prezzi onesti a pranzo."},
{b:7, n:"Tuppulia", z:"Palermo", min:174, km:223.3, t:"dolci", g:"", a:"Via Gaetano Daita 38", d:"Gusti creativi: cannella, Elvis al burro d'arachidi."},
{b:7, n:"Badalamenti Cucina e Bottega", z:"Mondello, Palermo", min:192, km:234.9, t:"pesce pasta", g:"locali", d:"Storia familiare, meta ricorrente degli chef palermitani nel loro giorno libero. Da abbinare a una giornata a Mondello."},
{b:7, n:"Mondello", z:"Palermo", min:192, km:234.9, t:"mare", g:"", fo:"sabbia", img:"mondello.jpg", d:"La spiaggia storica di Palermo: acqua turchese, lido liberty e zona libera. Il bagno più comodo della zona."},
{b:7, n:"Riserva dello Zingaro", z:"Tra San Vito e Scopello", min:245, km:299.8, t:"mare vedere", g:"nascosto", fo:"ciottoli", img:"zingaro.jpg", d:"Sette chilometri di costa senza strade, calette di ciottoli bianchi raggiungibili solo a piedi. Portate acqua: dentro non ci sono bar."},
{b:7, n:"Aleci Pasticceria", z:"Trapani", min:255, km:317.7, t:"dolci", g:"eco", a:"Piazza Scarlatti 3", d:"Cannoli tra i migliori assaggiati, ottimo rapporto qualità-prezzo."},
{b:7, n:"Bizzart Trapani", z:"Trapani", min:255, km:317.7, t:"pizza", g:"eco", a:"Via Francesco Manzo 21", d:"Impasto perfetto, ingredienti freschi, anche da asporto."},
{b:7, n:"Corso Vittorio Emanuele", z:"Trapani", min:255, km:317.7, t:"spesa", g:"", img:"corsovittoriotp.jpg", d:"La via del centro storico, con le botteghe di corallo lavorato: tradizione trapanese storica. Anche tessuti e ceramica."},
{b:7, n:"La Taverna dei Corsari", z:"Trapani", min:255, km:317.7, t:"pesce pasta", g:"", a:"Via S. Francesco D'Assisi 95", d:"Busiate al ragù di triglia e cous cous eccellente, pesce sempre freschissimo."},
{b:7, n:"Pasticceria La Rinascente", z:"Trapani", min:255, km:317.7, t:"dolci", g:"top", a:"Via Gatti 3", d:"Cannoli farciti al momento, genovesi eccellenti. Tappa obbligata."},
{b:7, n:"Pastry Vito Filingeri", z:"Trapani", min:255, km:317.7, t:"dolci spesa", g:"", a:"Via Colonnello Romey 37", d:"Anche frutta martorana realistica, pasta di mandorla a forma di frutta."},
{b:7, n:"Pizza Gourmet Trapani", z:"Trapani", min:255, km:317.7, t:"pizza", g:"top", a:"Via G. Errante 14", d:"Per molti la migliore pizza mai mangiata in Italia. Provate la Mortadella & Tartufo."},
{b:7, n:"Pizzeria La Tavernetta", z:"Trapani", min:255, km:317.7, t:"pizza pasta", g:"", a:"Via Marino Torre 206/208", d:"Ottima anche per la pasta: busiate alla Norma tra le più consigliate."},
{b:7, n:"Trattoria Pizzeria La Fenice", z:"Trapani", min:255, km:317.7, t:"pizza pasta", g:"", a:"Via Ruggero di Lauria Ammiraglio 5", d:"Pizza e pasta alla Norma entrambe top, ambiente accogliente."},
{b:7, n:"Saline di Trapani", z:"Verso Marsala", min:261, km:334.6, t:"vedere", g:"nascosto", img:"trapani.jpg", d:"Vasche d'acqua rosa, cumuli bianchi di sale e mulini a vento in fila. Al tramonto è uno dei paesaggi più fotografati dell'isola."},
{b:7, n:"Erice", z:"Sopra Trapani", min:264, km:336, t:"vedere dolci", g:"nascosto", img:"erice.jpg", d:"Borgo medievale a 750 m, spesso nella nebbia mentre sotto ci sono 35 gradi. Vicoli in pietra e le genovesi della Pasticceria Maria Grammatico."},
{b:7, n:"Pasticceria Maria Grammatico", z:"Erice", min:264, km:336, t:"dolci", g:"top", a:"Via Vittorio Emanuele 14", d:"Le genovesi calde e la pasta di mandorla secondo le ricette del convento dove Maria Grammatico imparo' da bambina. E' il motivo per cui molti salgono a Erice."},
{b:7, n:"Ristorante Dal Cozzaro", z:"San Vito Lo Capo", min:289, km:331.1, t:"pesce", g:"", a:"Via Savoia 19", d:"Pasta di mare molto apprezzata: carbonara di mare, ricci."},
{b:7, n:"Ristorante Rais", z:"San Vito Lo Capo", min:289, km:331.1, t:"pesce", g:"top", a:"Via Principe Tommaso 8", d:"Cous cous Mari e Storie tra i migliori della zona, servizio eccellente."},
{b:7, n:"San Vito Lo Capo", z:"San Vito Lo Capo", min:289, km:331.1, t:"mare", g:"top", fo:"sabbia", img:"sanvito.jpg", d:"Sabbia bianca, acqua da Caraibi, Monte Monaco alle spalle. Regolarmente in cima alle classifiche delle spiagge italiane. Ad agosto è affollata."},
{b:7, n:"Trattoria 3.0 I Siciliani in Cucina", z:"San Vito Lo Capo", min:289, km:331.1, t:"pasta", g:"eco", a:"Via Regina Margherita 63", d:"Porzioni abbondanti, molti clienti tornano ogni sera del soggiorno."},
{b:7, n:"Via Savoia e Via Regina Margherita", z:"San Vito Lo Capo", min:289, km:331.1, t:"spesa", g:"eco", d:"Negozi turistici sul lungomare: costumi, teli mare, souvenir semplici. Comodo se siete lì per la spiaggia."},
{b:7, n:"Isole Egadi — Cala Rossa", z:"Favignana", min:291, km:351.7, t:"mare", g:"", fo:"scogli", img:"egadi.jpg", piu:["egadi-2.jpg"], d:"Un'ora d'auto più traghetto da Trapani. Ex cava di tufo crollata nel mare: acqua verde smeraldo tra pareti bianche."},
{b:2, n:"Trattoria Il Nespolo", z:"Aci Trezza", min:11, km:6.2, t:"pesce", g:"", a:"Aci Trezza, lungo la via provinciale", d:"Trattoria di pesce nel borgo dei faraglioni, cucina semplice sul pescato. Ad Aci Trezza il pesce arriva dalla barca, ed è il motivo per fermarsi qui invece che a Catania. Segnalata dalla stampa gastronomica, non era nel documento di partenza."},
{b:2, n:"A putìa di Colapesce", z:"Aci Trezza", min:12, km:6.7, t:"pesce street", g:"", a:"Via Marina 13", d:"Piatti di pesce e specialità siciliane da banco, arancini compresi. Piccola e informale, sul lungomare. Segnalata dalla stampa gastronomica, non era nel documento di partenza."},
{b:5, n:"Caffè Sicilia", z:"Noto", min:89, km:105.6, t:"dolci", g:"top", a:"Corso Vittorio Emanuele 125", d:"Pasticceria storica di Noto, oltre 120 anni di attività. Corrado Assenza è fra i pasticceri più premiati d’Italia e la granita di mandorla è la sua firma. Proprio perché è famoso, ad agosto c’è fila: andateci presto la mattina. Dalla stampa gastronomica, non dal documento di partenza."},
{b:5, n:"Caffè Costanzo", z:"Noto", min:89, km:105.6, t:"dolci", g:"", a:"Via Silvio Spaventa 7/9", d:"L’altra pasticceria di Noto, con i tavolini davanti alla cattedrale. Granite al limone, caffè e mandarino, e i dolci di mandorla. Alternativa se davanti al Caffè Sicilia trovate la coda. Dalla stampa gastronomica, non dal documento di partenza."},
{b:6, n:"La Bettola", z:"Ragusa Ibla", min:117, km:115.4, t:"street", g:"eco", a:"Ragusa Ibla", d:"Tavola calda con scacce e focacce fatte a mano con farine locali, più arancine. Informale, si mangia in piedi o al volo: è il modo giusto di provare la scaccia ragusana senza sedersi al ristorante. Dalla stampa gastronomica, non dal documento di partenza."},
{b:6, n:"Panificio Giummarra", z:"Ragusa", min:118, km:121.1, t:"street", g:"eco", a:"Ragusa", d:"Forno noto per la scaccia campagnola. Si compra a peso e si mangia camminando. Dalla stampa gastronomica, non dal documento di partenza."},
{b:3, n:"4 Archi", z:"Milo", min:26, km:18.6, t:"pizza pasta carne", g:"siciliani nascosto", a:"Via Francesco Crispi 9", d:"Osteria di montagna aperta dal 1995 ai piedi dell’Etna, in un paese di seicento abitanti. In cucina c’è Lina: funghi, verdure di stagione, pasta fatta a mano, maialino nero dei Nebrodi, e la pizza nel forno a legna. È uno dei tre locali siciliani con i Tre Gamberi, e Milo non è un posto in cui si capita per caso: ci si va apposta. Fonte: Chiocciola Slow Food e Tre Gamberi del Gambero Rosso."},
{b:4, n:"San Giorgio e il Drago", z:"Randazzo", min:58, km:54.5, t:"pasta carne", g:"siciliani nascosto", d:"Trattoria dentro il borgo medievale di Randazzo, sul versante nord dell’Etna. Cucina di territorio vera: verdure di stagione, funghi, salumi e formaggi dei Nebrodi, pasta fresca tirata a mano. Randazzo è di pietra lavica nera ed è fuori dal giro dei pullman. Fonte: Chiocciola Slow Food."},
{b:4, n:"Ristorante Veneziano", z:"Randazzo", min:55, km:52.2, t:"carne pasta", g:"siciliani", a:"Contrada Arena", d:"Fuori dal paese, in contrada Arena. Piatti semplici e generosi: funghi dell’Etna, formaggi locali, maialino nero dei Nebrodi. Il Bib Gourmand è il simbolo che la Michelin dà a chi fa mangiare bene spendendo poco, ed è il riconoscimento giusto da cercare per un posto così. Fonte: Bib Gourmand della guida Michelin."},
{b:3, n:"In cucina dai Pennisi", z:"Linguaglossa", min:34, km:34.7, t:"carne", g:"siciliani", a:"Via Umberto I 9", d:"Macelleria con cucina: si sceglie il taglio al banco e lo cuociono sulla fiamma viva. Carni frollate in casa e poi marinate. Circa 30 euro, indicativo. È il modo in cui i paesi dell’Etna hanno sempre mangiato la carne, prima che diventasse una moda in città. Fonte: Bib Gourmand della guida Michelin, new entry 2026."},
{b:3, n:"Trattoria LinguaGrossa", z:"Linguaglossa", min:34, km:34.8, t:"pasta", g:"siciliani eco", a:"Via Guglielmo Marconi 100", d:"Trattoria di paese con i vini dell’Etna. Pane fritto con i carciofi, casarecce fatte a mano, gli “sciauni” che sono ravioli fritti. Sui 35–40 euro, indicativo. Fonte: segnalata dalla stampa gastronomica (Scatti di Gusto)."},
{b:2, n:"Pasticceria Russo", z:"Santa Venerina", min:20, km:12.4, t:"dolci", g:"siciliani", d:"Pasticceria di paese dal 1880, a un quarto d’ora da casa. Granite e pasticceria siciliana senza scenografie per turisti. Santa Venerina è un paese di passaggio: nessuno ci va per fare foto, ci si ferma per la granita. Fonte: segnalata dalla stampa gastronomica (Scatti di Gusto)."},
{b:4, n:"Pasticceria Musumeci", z:"Randazzo", min:58, km:54.5, t:"dolci", g:"siciliani", d:"Giovanna Musumeci fa granite di gelso, mandorla e perfino di melanzana, e si diverte con il salato: pizza fritta con la granita, focaccia con la pancetta. Vale la sosta se si sale a Randazzo. Fonte: segnalata dalla stampa gastronomica (Scatti di Gusto)."},
{b:2, n:"Casu Osteria Contemporanea", z:"Giarre", min:20, km:17.5, t:"pasta pesce carne", g:"siciliani", a:"Corso Italia 294", d:"Mario Casu ha aperto nel 2022 dentro l’ex fabbrica di confetti in cui entrava da bambino. Poche tavole sul corso, menu che cambia, prezzi onesti. Giarre era rimasta scoperta in questa guida proprio perché di locali se ne trovavano solo nelle classifiche di prenotazione: questo invece è segnalato per la cucina. Fonte: guida Michelin e premio Best in Sicily 2024 come trattoria."},
{b:3, n:"Vico Astemio", z:"Riposto", min:21, km:18.2, t:"pesce", g:"siciliani", a:"Via Camillo Benso Conte di Cavour 34", d:"In un vicolo di Riposto, da cui il nome. Pesce e carne con un menu che segue la stagione, e una carta dei vini scelta bene. Riposto è il porto sotto l’Etna: il pesce arriva lì. Anche questa zona era rimasta scoperta. Fonte: selezione della guida Michelin."},
{b:3, n:"Mé Cumpari Turiddu", z:"Catania", min:22, km:14.6, t:"pasta carne", g:"siciliani top", a:"Piazza Turi Ferro 36", d:"Osteria e putia insieme: si mangia in mezzo agli scaffali di piccole produzioni artigianali siciliane, che si possono anche comprare. Cucina della memoria, fatta con i presidi Slow Food. È l’unico locale di Catania ad avere sia la Chiocciola sia il Bib Gourmand. Fonte: Chiocciola Slow Food e Bib Gourmand della guida Michelin."},
{b:6, n:"Andrea — Sapori Montani", z:"Palazzolo Acreide", min:100, km:96.1, t:"carne pasta", g:"siciliani nascosto", a:"Corso Vittorio Emanuele", d:"Palazzolo Acreide è un paese barocco sui monti Iblei con tre osterie nella guida Slow Food: una densità che non ha nemmeno Palermo. Questa è quella dei sapori di montagna, carne e paste fatte in casa, e ha anche il Bib Gourmand. Fonte: Chiocciola Slow Food e Bib Gourmand della guida Michelin."},
{b:6, n:"Lo Scrigno dei Sapori", z:"Palazzolo Acreide", min:103, km:90.5, t:"pasta carne", g:"siciliani nascosto", d:"La seconda delle tre osterie di Palazzolo premiate da Slow Food. Cucina iblea di casa, in un paese dove si sale apposta. Fonte: Chiocciola Slow Food."},
{b:6, n:"Trattoria del Gallo", z:"Palazzolo Acreide", min:101, km:90.1, t:"pasta carne", g:"siciliani nascosto eco", a:"Via Roma 228", d:"La terza di Palazzolo Acreide, e la più semplice: trattoria di paese a conduzione familiare. Se le altre due sono piene, questa è il posto. Fonte: Chiocciola Slow Food."},
{b:6, n:"U Sulicce’nti", z:"Rosolini", min:103, km:120, t:"pasta carne pesce", g:"siciliani nascosto", a:"Via Manzoni, Piazza Giuseppe Garibaldi", d:"Rosolini non è un paese che si visita: è un paese dove si vive, nell’estremo sud. Per questo l’osteria è fatta per chi ci abita, e la Chiocciola dice che è fatta bene. Fonte: Chiocciola Slow Food."},
{b:6, n:"Cucina e Vino", z:"Ragusa Ibla", min:117, km:115.3, t:"pasta carne", g:"siciliani eco", d:"Dentro Ibla, a due passi dai palazzi barocchi ma su tutt’altro registro: trattoria vera, prezzi da trattoria. Nel posto più fotografato della Sicilia sud-orientale è la scelta che fanno i ragusani. Fonte: Chiocciola Slow Food."},
{b:5, n:"Latteria Mamma Iabica", z:"Siracusa", min:70, km:81.7, t:"pasta", g:"siciliani", d:"A Siracusa, dove quasi tutto è tarato sul turista di Ortigia, questa è una latteria-osteria che punta su formaggi e cucina del territorio. Fonte: Chiocciola Slow Food."},
{b:6, n:"Fratelli Borrello", z:"Sinagra", min:103, km:93, t:"carne", g:"siciliani nascosto", a:"Contrada Forte 7", d:"Sui Nebrodi, in un paese di tremila abitanti. I Borrello allevano il suino nero dei Nebrodi, presidio Slow Food, e lo cucinano loro. Qui il tag “ci vanno i siciliani” è letterale: a Sinagra non arriva nessun altro. Fonte: Chiocciola Slow Food."},
{b:6, n:"Da Luciana", z:"San Piero Patti", min:101, km:82.1, t:"pasta carne", g:"siciliani nascosto", d:"Osteria di campagna sui Nebrodi, in un paese che non compare su nessuna guida turistica. Fonte: guida Osterie d’Italia di Slow Food."},
{b:4, n:"Tischi Toschi", z:"Taormina", min:36, km:41.6, t:"pasta", g:"siciliani", a:"Via Paladini 3", d:"Sedici coperti in una via laterale di Taormina, cioè l’esatto contrario di quello che ci si aspetta a Taormina. Cucina siciliana di ricerca a prezzi da trattoria: è uno dei tre locali siciliani con i Tre Gamberi. Prenotare, sempre. Fonte: Tre Gamberi del Gambero Rosso."},
{b:7, n:"Nangalarruni", z:"Castelbuono", min:160, km:182.1, t:"carne pasta", g:"siciliani nascosto", d:"Sulle Madonie, il regno dei funghi e del manna. Giuseppe Carollo cucina funghi, erbe spontanee e carni locali. Castelbuono è un borgo dell’interno: da Aci Catena è un’escursione, non una cena. Fonte: Chiocciola Slow Food e Bib Gourmand della guida Michelin."},
{b:7, n:"Corona Trattoria", z:"Palermo", min:176, km:225.3, t:"pesce pasta", g:"siciliani", a:"Via Giovanni Grasso 4", d:"Trattoria palermitana di quartiere, pesce e cucina popolare. Fonte: Chiocciola Slow Food."},
{b:7, n:"Buatta Cucina Popolana", z:"Palermo", min:174, km:223.3, t:"pasta carne", g:"siciliani", d:"Cucina popolare palermitana rifatta bene: sarde a beccafico, pasta con le sarde, involtini. Anche questo ha i Tre Gamberi. Fonte: Bib Gourmand della guida Michelin e Tre Gamberi del Gambero Rosso."},
{b:7, n:"Cantina Siciliana", z:"Trapani", min:258, km:331.4, t:"pesce pasta", g:"siciliani", d:"Nel quartiere ebraico di Trapani, cucina trapanese: cous cous di pesce, busiate col pesto alla trapanese. Fonte: Chiocciola Slow Food."},
{b:5, n:"Casa & Putia", z:"Messina", min:63, km:81.5, t:"pasta pesce", g:"siciliani", d:"Osteria e bottega a Messina, con la cucina dello Stretto: pesce azzurro, verdure, pasta fatta in casa. Fonte: Chiocciola Slow Food."},
{b:6, n:"Ginger People & Food", z:"Agrigento", min:135, km:167.9, t:"pasta carne", g:"siciliani", d:"Nel centro di Agrigento, a due passi dalla Valle dei Templi ma su un altro pianeta rispetto ai menu turistici della zona. Cucina agrigentina fatta con i piccoli produttori. Fonte: Chiocciola Slow Food e Alleanza Slow Food dei cuochi."},
{b:6, n:"Terracotta", z:"Agrigento", min:138, km:172.9, t:"pasta pesce", g:"siciliani", d:"L’altra osteria di Agrigento segnalata da Slow Food, sulla strada dei templi. Fonte: guida Osterie d’Italia di Slow Food."},
{b:6, n:"Oasi Osteria del Mare", z:"Licata", min:140, km:146, t:"pesce", g:"siciliani nascosto", a:"Via Marconi 45", d:"Licata è un porto di pescatori che non compare su nessun itinerario turistico. L’osteria lavora il pescato del giorno, ed è una delle venti Chiocciole siciliane. Fonte: Chiocciola Slow Food e Alleanza Slow Food dei cuochi."},
{b:7, n:"Arrhais", z:"Pollina", min:162, km:224.9, t:"carne pasta", g:"siciliani nascosto", a:"Contrada San Nicola", d:"Pollina è un borgo delle Madonie a settecento metri, mille abitanti, affacciato sul mare da lontano. Cucina madonita: erbe, funghi, carni, formaggi del posto. Fonte: Chiocciola Slow Food."},
{b:7, n:"Caupona Taverna di Sicilia", z:"Trapani", min:260, km:332.2, t:"pasta pesce", g:"siciliani", d:"La seconda Chiocciola di Trapani, insieme a Cantina Siciliana. Cucina trapanese di terra e di mare. Fonte: Chiocciola Slow Food."},
{b:6, n:"Agriturismo Giannavì", z:"Palazzolo Acreide", min:104, km:92.5, t:"carne pasta", g:"siciliani nascosto", d:"La quarta tavola di Palazzolo Acreide riconosciuta da Slow Food, e l’unica in campagna: agriturismo che cucina quello che coltiva e alleva. Fonte: Alleanza Slow Food dei cuochi."},
{b:6, n:"I Banchi", z:"Ragusa Ibla", min:120, km:116.9, t:"pasta pizza", g:"siciliani", a:"Via Orfanotrofio 39", d:"Panificio con cucina dentro Ibla, aperto da Ciccio Sultano: è la sua tavola informale, non il ristorante stellato. Pane, pizza e piatti ragusani a prezzi da trattoria, ed è la trattoria siciliana più in alto nella classifica 50 Top Italy. Sulla stessa via, al 91, c’è Cucina e Vino: due modi diversi di mangiare bene a cento metri l’uno dall’altro. Fonte: ventesima trattoria d’Italia per la classifica 50 Top Italy 2026."},
{b:6, n:"Fattoria Borrello — Osteria del Maiale Nero", z:"Raccuja", min:102, km:83.7, t:"carne", g:"siciliani nascosto", a:"Contrada Bosco", d:"Cento ettari dentro il parco dei Nebrodi: allevano il suino nero allo stato brado, lo stagionano e lo cucinano loro, nella stessa fattoria. È la sorella di Fratelli Borrello di Sinagra, stessa famiglia. Raccuja ha milletrecento abitanti e non ci passa nessuno per caso. Attenzione al segnaposto: la fattoria è in contrada Bosco, fuori dal paese, ma quella contrada sulle mappe non risulta, quindi il punto indica il centro di Raccuja e il tempo è calcolato fin lì. Telefonate per farvi dire la strada. Fonte: Chiocciola Slow Food e quarantaduesima trattoria d’Italia per 50 Top Italy 2026."},
{b:5, n:"Osteria U’Locale", z:"Buccheri", min:86, km:76.9, t:"carne pasta", g:"siciliani nascosto", a:"Via Dusmet 14", d:"Buccheri sta a ottocento metri sui monti Iblei e ha duemila abitanti. Verdure selvatiche, tagliatelle fatte in casa, spiedini di pecora: cucina iblea di montagna, che è una cosa diversa dal barocco del Val di Noto lì sotto. Fonte: le dieci migliori trattorie della Sicilia orientale per Cronache di Gusto."},
{b:4, n:"Terra Mia", z:"Castiglione di Sicilia", min:43, km:42.3, t:"pasta carne", g:"siciliani nascosto", a:"SP64, frazione Solicchiata", d:"A Solicchiata, in mezzo alle vigne dell’Etna nord. Leonardo Cuscona fa ricette semplici di una volta: paste fresche, funghi, trote dei Nebrodi. Fonte: le dieci migliori trattorie della Sicilia orientale per Cronache di Gusto."},
{b:6, n:"Locanda del Colonnello", z:"Modica", min:126, km:123.8, t:"pasta pesce", g:"siciliani", a:"Vico Biscari 6", d:"In un vicolo di Modica, sopra la scalinata. Ravioli di patate, pesce in guazzetto, prodotti iblei trattati con fantasia. Modica è piena di posti per turisti: questo non lo è. Fonte: le dieci migliori trattorie della Sicilia orientale per Cronache di Gusto."},
{b:5, n:"Al Bagatto", z:"Milazzo", min:92, km:117.5, t:"pasta carne", g:"siciliani", a:"Via Regis 11", d:"A Milazzo, dove quasi tutti si fermano solo per prendere il traghetto per le Eolie. Pasta fresca con farine antiche, carne modicana, ortaggi del giorno. Fonte: le dieci migliori trattorie della Sicilia orientale per Cronache di Gusto."},
{b:7, n:"Don Ciccio", z:"Bagheria", min:160, km:208.9, t:"pasta carne", g:"siciliani", a:"Via del Cavaliere 87", d:"Trattoria storica di Bagheria: pasta con le sarde e bruciuluni, cioè gli involtini palermitani. Tradizione senza rifacimenti. Fonte: le dieci migliori trattorie della Sicilia occidentale per Cronache di Gusto."},
{b:7, n:"La Tonnara", z:"Castellammare del Golfo", min:227, km:289.7, t:"pesce", g:"siciliani", a:"Via Don Luigi Zangara 29", d:"Pesce fresco a Castellammare: linguine con le ostriche e anemone di mare. Fonte: le dieci migliori trattorie della Sicilia occidentale per Cronache di Gusto."},
{b:7, n:"Osteria dei Folli", z:"Realmonte", min:154, km:186.3, t:"carne pasta", g:"siciliani nascosto", a:"Piazza Umberto I 27", d:"Nella piazza di Realmonte, il paese della Scala dei Turchi: menu del giorno con prodotti biologici del posto e carni Dop. Chi visita la Scala di solito mangia sulla spiaggia, non qui. Fonte: le dieci migliori trattorie della Sicilia occidentale per Cronache di Gusto."},
{b:7, n:"Antica Forneria Messina", z:"Monreale", min:188, km:234.8, t:"pizza pasta", g:"siciliani", a:"Viale Regione Siciliana 100, San Martino delle Scale", d:"A San Martino delle Scale, sopra Monreale, in montagna: pizza artigianale, pasta fresca e carni servite sulla ghisa. Fonte: le dieci migliori trattorie della Sicilia occidentale per Cronache di Gusto."},
{b:7, n:"Al Ritrovo", z:"San Vito Lo Capo", min:273, km:321.8, t:"pesce", g:"siciliani", a:"Viale Cristoforo Colombo 314, Castelluccio", d:"Cous cous di pesce e frutti di mare a San Vito, che di cous cous è la capitale. Sta a Castelluccio, fuori dal centro pedonale pieno di locali per turisti. Fonte: le dieci migliori trattorie della Sicilia occidentale per Cronache di Gusto."},
{b:2, n:"Basula Braceria Barocca", z:"Acireale", min:8, km:3.3, t:"carne", g:"", a:"Corso Savoia 20", fork:"https://www.thefork.it/ristorante/basula-braceria-barocca-r717790", d:"Braceria nel centro barocco di Acireale: tagli alla griglia, tomahawk, polpette di scottona. Ad Acireale e Aci Catena la guida non aveva un solo posto dove mangiare carne, e questo lo copre. Attenzione alla provenienza: non l’ha segnalato una guida gastronomica, l’ho preso da TheFork, dove ha un voto molto alto — che è un’altra cosa."},
{b:2, n:"Braceria Corte Marconi", z:"Acireale", min:7, km:3.1, t:"carne", g:"", a:"Piazza Marconi 16", fork:"https://www.thefork.it/ristorante/braceria-corte-marconi-r824692", d:"Carni selezionate alla brace, hamburger e piatti siciliani, con una carta dei vini del territorio. L’altra braceria di Acireale, a otto minuti da casa. Anche questa arriva da TheFork e non da una guida gastronomica."},
{b:2, n:"Tenuta Carminello", z:"Valverde", min:11, km:5.7, t:"carne pizza", g:"", a:"Via Carminello 21", fork:"https://www.thefork.it/ristorante/tenuta-carminello-r852483", d:"Sulla collina di Valverde, fra l’Etna e il mare di Aci Trezza: carne alla brace con una scelta di selvaggina, e anche la pizza. È il voto più alto della zona su TheFork (9,1), da dove l’ho preso — non da una guida gastronomica."},
{b:3, n:"Brace", z:"Catania", min:21, km:13.2, t:"carne", g:"", a:"Via Domenico Cimarosa 12", fork:"https://www.thefork.it/ristorante/brace-r691267", d:"Braceria catanese fuori dal giro del centro storico: tagli scelti e cottura precisa. Da TheFork, dove ha 8,8."},
{b:2, n:"Trattoria Incognito", z:"Acireale", min:7, km:3.3, t:"pesce", g:"", a:"Via Giovanni Verga 58", d:"Trattoria di pesce con menù fisso, molto frequentata. Non l’ha segnalata una guida gastronomica: è presa da Google Maps, dove ha 4,5 su 1717 recensioni."},
{b:2, n:"Ristorante La Polena", z:"Acireale", min:9, km:4.4, t:"pesce", g:"", a:"Via Nazionale per Catania 178", d:"Cucina di pesce in ambiente rustico, uno dei ristoranti più recensiti della zona. Trovato su Google Maps: 4,3 su 2637 recensioni."},
{b:2, n:"Racina — Taverna d’autore", z:"Acireale", min:8, km:3.4, t:"pasta", g:"", a:"Via Monsignor Genuardi 36", d:"Il voto più alto fra le trattorie di Acireale su Google Maps: 4,9 su 292 recensioni. Pasta alla norma e paccheri al pistacchio, dicono le recensioni. Non è una segnalazione di guida."},
{b:2, n:"Trattoria U Puttusu", z:"Acireale", min:7, km:3.3, t:"carne pasta", g:"", a:"Via Vittorio Emanuele II 175", d:"Trattoria di carne e cucina di casa, nel centro di Acireale. Da Google Maps: 4,5 su 887 recensioni."},
{b:2, n:"Il Tino", z:"Acireale", min:12, km:8, t:"carne", g:"", a:"Via Nazionale Guardia 129", d:"Carne alla griglia con un’ampia scelta di antipasti, secondo le recensioni. Da Google Maps: 4,8 su 416 recensioni."},
{b:2, n:"Pasticceria Siciliana Palummo", z:"Acireale", min:13, km:8.7, t:"dolci", g:"", a:"Via Birago 1", d:"Granite, paste di mandorla e cornetti. Da Google Maps: 4,5 su 345 recensioni."},
{b:2, n:"Re Dolce Freddo", z:"Acireale", min:7, km:3.2, t:"dolci", g:"", a:"Via Giovanni Verga 53", d:"Pasticceria molto frequentata, una delle più recensite di Acireale. Da Google Maps: 4,5 su 1519 recensioni."},
{b:2, n:"Trattoria Pizzeria Al Peschereccio", z:"Aci Catena", min:9, km:4.8, t:"pesce carne pizza", g:"", a:"Via Vampolieri 61", d:"A due passi da casa: pesce, carne e pizza nello stesso posto. Ad Aci Catena la guida non aveva un solo posto per carne o pesce, e questo copre entrambi. Da Google Maps: 4,1 su 403 recensioni."},
{b:2, n:"Odissea Ristorante Pizzeria Bar Vampolieri", z:"Aci Catena", min:9, km:4.8, t:"pizza pasta", g:"", a:"Via Vampolieri 53/55", d:"Ristorante pizzeria bar sulla stessa via del Peschereccio. Il voto più alto di Aci Catena su Google Maps: 4,8 su 348 recensioni."},
{b:2, n:"Masè Ristorante di Pesce", z:"Aci Castello", min:14, km:8, t:"pesce", g:"", a:"Via Savoia 35", d:"Nel centro storico di Aci Castello, sotto il castello normanno. Aci Castello non aveva un solo posto dove mangiare in questa guida. Da Google Maps: 4,8 su 421 recensioni."},
{b:2, n:"Ristorante Giancarlo Barone", z:"Aci Castello", min:15, km:8.2, t:"pesce carne", g:"", a:"Lungomare Cristoforo Colombo 15", d:"Fronte castello, vista sui faraglioni. Pesce e carne insieme, con oltre duemila recensioni: il locale più recensito della zona. Da Google Maps: 4,3 su 2188 recensioni."},
{b:2, n:"Ristorante Bettola", z:"Aci Castello", min:15, km:8.2, t:"pesce", g:"", a:"Piazza Castello 20", d:"Piatti di pesce in atmosfera familiare, sulla piazza del castello, con vista sui faraglioni di Aci Trezza. Da Google Maps: 4,1 su 886 recensioni."},
{b:2, n:"Tutto Pizza Valverde", z:"Valverde", min:9, km:4.9, t:"pizza", g:"", a:"Via Calì 10", d:"Pizzeria di Valverde, sottile e croccante secondo le recensioni. Da Google Maps: 4,5 su 328 recensioni."},
{b:2, n:"Trattoria Miró", z:"Valverde", min:9, km:4.8, t:"pesce", g:"", a:"Corso Vittorio Emanuele III 32", d:"Cucina di pesce a Valverde, fascia di prezzo più alta della media della zona. Da Google Maps: 4,5 su 257 recensioni."},
{b:2, n:"Osteria Dei Marinai da Graziano", z:"Aci Castello", min:15, km:8.2, t:"pasta pesce", g:"", a:"Via Lungomare dei Ciclopi 185", d:"Cucina mediterranea sul lungomare dei Ciclopi. Da Google Maps: 4,3 su 1167 recensioni."},
{b:2, n:"Trattoria Porto Nuovo", z:"Aci Trezza", min:11, km:6.1, t:"pesce", g:"", a:"Via Lungomare 143/b", d:"Sul lungomare di Aci Trezza, il locale più recensito del borgo dei faraglioni. Da Google Maps: 4,4 su 2480 recensioni."},
{b:2, n:"Bracireale", z:"Acireale", min:6, km:2.8, t:"carne street", g:"", a:"Via Salvatore Vigo 32", d:"Pollo allo spiedo e gastronomia da asporto, ad Acireale. Da Google Maps: 4,7 su 37 recensioni — un campione piccolo, da prendere con più cautela degli altri."},
{b:2, n:"Nero Grill", z:"Aci Bonaccorsi", min:9, km:5.2, t:"carne", g:"", a:"Piazza della Regione 3", d:"Griglia in stile americano — brisket, costine, affumicati — ad Aci Bonaccorsi, il paese confinante con Aci Catena. Da Google Maps: 4,6 su 288 recensioni."},
{b:2, n:"Il Rosticcere", z:"Acireale", min:8, km:4.3, t:"street", g:"", a:"Corso Savoia 50", d:"Arancini e rosticceria sul corso principale di Acireale, uno dei più recensiti della città. Da Google Maps: 4,6 su 778 recensioni."},
